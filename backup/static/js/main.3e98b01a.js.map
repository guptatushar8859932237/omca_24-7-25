                                        <i class="borderBtn ti ti-plus f-20"></i>
                                      </div>
                                    </div>
                                  </div>
                                  <div className="card-body p-0 bg-white rounded-bottom-4">
                                    <div className="table-responsive">
                                      <table className="table">
                                        <thead>
                                          <tr>
                                            <th>SR</th>
                                            <th>Illness</th>
                                            <th>Action</th>
                                          </tr>
                                        </thead>
                                        <tbody>
                                          {chronicillness1 &&
                                            chronicillness1.length > 0 ? (
