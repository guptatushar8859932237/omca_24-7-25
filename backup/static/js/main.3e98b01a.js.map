                                <div className="col-md-6">
                                  <label className="form-label">
                                    Risk of Fall
                                  </label>
                                  <br />
                                  {["Low", "Medium", "High"].map((option) => {
                                    const getColorClass = () => {
                                      if (formData.risk_of_fall !== option)
                                        return "";
                                      if (option === "High")
                                        return "text-danger";
                                      if (option === "Medium")
                                        return "text-warning";
                                      if (option === "Low")
                                        return "text-success";
                                    };

                                    return (
                                      <label
                                        className={`me-3 form-label ${getColorClass()}`}
