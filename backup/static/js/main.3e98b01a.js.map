                                                <button
                                                  className="cancelText"
                                                  onClick={
                                                    handleClosepanassesemnt
                                                  }
                                                >
                                                  Cancel
                                                </button>
                                                <button
                                                  className="bgBtn"
                                                  onClick={
                                                    handldeapichanganassesment
                                                  }
                                                >
                                                  Save
                                                </button>
                                              </div>
                                            </div>
                                          </div>
