                                                onChange={handleMedicineChange}
                                                placeholder="strength"
                                              />
                                            </div>
                                            <div className="col-6">
                                              <label className="form-label">
                                                Unit
                                              </label>
                                              <input
                                                className="form-control"
                                                name="unit"
                                                value={medicineData.unit}
                                                onChange={handleMedicineChange}
                                                placeholder="unit"
                                              />
                                            </div>
                                            <div className="col-12 mt-2 text-center">
                                              <button
                                                type="button"
                                                className="borderBtn"
                                                onClick={handleAddMedicine}
                                              >
                                                {editIndex !== null
                                                  ? "Update Medicine"
                                                  : "Add Medicine"}
                                              </button>
                                            </div>
                                          </div>
                                          <div className="card-body mt-3 pb-0">
                                            <div className="table-responsive">
                                              <table className="table">
                                                <thead>
                                                  <tr>
                                                    <th>SR NO.</th>
                                                    <th>Medicine</th>
                                                    <th>Doses</th>
                                                    <th>Frequency</th>
                                                    <th>Duration </th>
