                                          <button
                                            type="button"
                                            className="bgBtn"
                                            onClick={handlesubmitprescription}
                                          >
                                            Submit Prescription
                                          </button>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              )}
                              <div className="tableHeader">
                                <div className="d-flex justify-content-between">
