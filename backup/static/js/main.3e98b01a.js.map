    } catch (error) {
      Swal.fire("Error", error.response?.data || error.message, "error");
    }
  };
  const Addchronicillness = async () => {
    const obj = {};
    console.log(props);
    try {
      const response = await axios.post(`${baseurl}addChronicIllness`, {
        patient_id: props?.patientId,
        illness_text: medicineData.illness_text,
      });
      if (response.data.success) {
        setprescriptionmodal1111(false);
        Swal.fire("success", "Chronic Illness Added Successfully", "Success");
        getChronicIllness();
      } else {
        console.log("Something went wrong");
      }
    } catch (error) {
      console.log(error.response?.data || error.message);
    }
  };

  const handlemodaldpresctiptionoprn = () => {
    setOpenDiagnosistab(true);
  };

  const hndleclosddddd = () => {
    setDiagonisemodal(false);
  };
  const handlemodaldiagonise = () => {
    console.log("ajkdgsdhg");
    setDiagonisemodal(true);
  };

  useEffect(() => {
    diagnosis_by_patient();
    prescription_by_patient();
  }, []);

  const diagnosis_by_patient = async () => {
    try {
      const response = await axios.get(
        `${baseurl}diagnosis_by_patient/${props?.patientId}`
      );

      if (response.status === 200 && response.data) {
        console.log(response.data);
        setDiagnosisList(response.data.data || []);
      } else {
        console.log("Error: Invalid response");
      }
    } catch (error) {
      console.error("API Error:", error);
    }
  };
  const prescription_by_patient = async () => {
    try {
      const response = await axios.get(
        `${baseurl}dental/prescription/${props?.patientId}`
      );

      if (response.status === 200 && response.data) {
        console.log(response.data.prescriptions);
        setPprescription(response.data.prescriptions || []);
      } else {
        console.log("Error: Invalid response");
      }
    } catch (error) {
      console.error("API Error:", error);
    }
  };

  const hadlenavigate = (id) => {
    navigate("/Admin/Prescription", { state: { id: id } });
  };
  ////////////////////////////////////////////////////////////////////// service working
  const loadAvailableServices = async () => {
    try {
      // Use same endpoint backing Service.jsx
      const response = await axios.get(
        `${baseurl}getDentalServices/${props.patientId}`
      );
      console.log(response.data);
      const list = (response.data?.data || []).map((item) => ({
        id: item.id,
        code: item.code,
        serviceName: item.name,
        description: item.description,
        standardCost: item.standard_price,
        secondaryCost: item.secondary_price,
        insurancePrice: item.insurance_price,
        duration: item.duration,
        DentalMode: item.DentalMode,
        isDental: item.isDental,
        vatLabel: item.vat,
        vatEnabled: (item.vat || "").toString().toLowerCase() === "yes",
        vatValue: Number(item.vat_value) || 0,
      }));
      setAvailableServices(list);
      console.log(list);
    } catch (error) {
      console.error("Error loading services:", error);
    }
  };
  const checkPatientInsuranceCard = async () => {
    try {
      const response = await axios.get(
        `${baseurl}getInsuranceCardsByPatientId/${props.patientId}`
      );
      console.log(response.data);
      const cards = Array.isArray(response.data?.data)
        ? response.data.data
        : [];
      const hasActiveCard = cards.some(
        (card) =>
          card.status === "Active" ||
          (card.expiry_date && new Date(card.expiry_date) > new Date())
      );
      setHasActiveInsuranceCard(hasActiveCard);
    } catch (error) {
      console.error("Error checking insurance card:", error);
      setHasActiveInsuranceCard(false);
    }
  };

  const loadPatientServices = async () => {
    try {
      const response = await axios.get(
        `${baseurl}getPatientServices/${props.patientId}`
      );
      const data = response.data?.data;
      const results = Array.isArray(data?.results)
        ? data.results
        : Array.isArray(data)
        ? data
        : [];
      // Capture server-provided totals if available
      const apiPlanTotal = Number(data?.planTotal) || 0;
      const apiCompletedTotal = Number(data?.completedTotal) || 0;
      const apiTotalPlanServices = Number(data?.totalPlanServices) || 0;
      const apiTotalCompleteServices = Number(data?.totalCompleteServices) || 0;
      setPlanTotal(apiPlanTotal);
      setCompletedTotal(apiCompletedTotal);
      setTotalPlanServices(apiTotalPlanServices);
      setTotalCompleteServices(apiTotalCompleteServices);
      setServices(results);
    } catch (error) {
      console.error("Error loading patient services:", error);
    }
  };
  const ahndleclickopenservicemodal32 = () => {
    setServiceModalOpen(true);
    checkPatientInsuranceCard();
  };

  console.log(availableServices);
  const filteredServices = availableServices.filter(
    (service) =>
      service.serviceName
        ?.toLowerCase()
        .includes(searchServiceQuery.toLowerCase()) ||
      service.code?.toLowerCase().includes(searchServiceQuery.toLowerCase())
  );

  const handleServiceSubmit = async (e) => {
    console.log(availableServices);
    e.preventDefault();

    const resolvedPatientId = Number(props.patientId);
    const resolvedServiceId = Number(serviceFormData.serviceId) || null;

    if (!resolvedPatientId) {
      Swal.fire("Error", "Missing patient or service selection", "error");
      return;
    }

    const selectedServiceData = availableServices.find(
      (s) => Number(s.id) === resolvedServiceId
    );
    if (!selectedServiceData) {
      Swal.fire("Error", "Please select a valid service", "error");
      return;
    }
    console.log(selectedServiceData);
    // Refresh insurance status before computing discount based on base cost
    await checkPatientInsuranceCard();
    const baseCost = hasActiveInsuranceCard
      ? selectedServiceData.insurancePrice ??
        selectedServiceData.insurance_price ??
        selectedServiceData.standardCost
      : selectedServiceData.standardCost;

    const discount =
      serviceFormData.discountType === "Percentage"
        ? (baseCost * serviceFormData.discountValue) / 100
        : serviceFormData.discountValue;
    const serviceData = {
      serviceId: resolvedServiceId,
      discount_type: serviceFormData.discountType,
      discount_value: serviceFormData.discountValue,
      extra_notes: serviceFormData.extraNotes,
      teeth_ids: selectedTeeth,
      surface_area_code: serviceFormData.surface_area_code,
      surface: serviceFormData.surface === "Yes" ? 1 : 0,
      amount: hasActiveInsuranceCard
        ? selectedServiceData?.DentalMode === "multiple"
          ? selectedServiceData?.insurancePrice ??
            selectedServiceData?.insurance_price ??
            ""
          : (selectedServiceData?.insurancePrice ??
              selectedServiceData?.insurance_price ??
              "") * selectedTeeth.length
        : selectedServiceData?.DentalMode === "multiple"
        ? selectedServiceData?.standardCost ?? ""
        : (selectedServiceData?.standardCost ?? "") * selectedTeeth.length,
    };
    console.log(serviceData);
    console.log(serviceFormData);
    try {
      if (selectedService) {
        await axios.put(
          `${baseurl}UpdatePatientServices/${selectedService.id}`,
          serviceData
        );
        Swal.fire("Success", "Patient service updated successfully", "success");
      } else {
        // Keep add flow as-is
        await axios.post(`${baseurl}AddDentalPatientService`, {
          patientId: resolvedPatientId,
          ...serviceData,
        });
        Swal.fire("Success", "Service added successfully", "success");
      }
      getdata();
      setServiceModalOpen(false);
      loadPatientServices();
    } catch (error) {
      console.error("Submit failed", error);
      const msg = error.response?.data?.message || "Something went wrong!";
      Swal.fire("Error", msg, "error");
    }
  };

  const handleAddService = () => {
    checkPatientInsuranceCard();
    setSelectedService(null);
    setServiceFormData({
      serviceId: "",
      extraNotes: "",
      discountType: "Amount",
      discountValue: 0,
      status: "Plan",
    });
    setSearchServiceQuery("");
    setShowServiceSuggestions(false);
    setServiceModalOpen(true);
  };
  useEffect(() => {
    getdata();
  }, []);
  const getdata = async () => {
    try {
      const response = await axios.get(
        `${baseurl}/getPatientServicesWithTeeth/${props.patientId}`
      );
      console.log(response.data);
      if (response.data.success === true) {
        setPatients(response.data.data);
      } else {
        console.error("Failed to fetch patient data:", response.data.message);
      }
    } catch (error) {
      console.error("Error fetching patient data:", error.message);
    }
  };

  ///////////////////////////////////////////////////////////  // cate filter/?////////////////////////////////////////

  const filterdate = async () => {
    try {
      const response = await axios.get(
        `${baseurl}getDentalServiceDatesByPatient/${props.patientId}`
      );
      if (response.data.success === true) {
        console.log(response.data.dates);
        setDatta(response.data.dates);
      } else {
        console.log("data not fetch");
      }
    } catch (error) {
      console.log(error);
    }
  };
  useEffect(() => {
    filterdate();
  }, []);

  const handledategetsaddt = (e) => {
    setDateqq(e.target.value);
    // console.log('====================================');
    // console.log(e.target.value);
    // console.log('====================================');
    let dateOnly = e.target.value.split("T")[0];
    console.log(dateOnly);
    setgetdatat(dateOnly);
    // const response =  axios.post(`${baseurl}getMedicalRecordsByDate/${location.state.patientid.id}`,{date:e.target.value})
    // console.log(response)
    // setNamevalue({...setNamevalue,[name]:value})
  };
  const setgetdatat = async (dateqq) => {
    try {
      const response = await axios.post(
        `${baseurl}getDentalPatientServicesByDate/${props.patientId}`,
        { date: dateqq }
      );
      console.log(response.data.data); // Full axios response object
      if (response.status === 200) {
        setPatients(response.data.data);
      } else {
        console.log("Something went wrong");
      }
    } catch (error) {
      console.error("Error fetching medical records:", error);
    }
  };

  const handleLabView = (plan) => {
    setOpenlabModal(true);
    getapidata(plan);
  };
  const getapidata = async (plan) => {
    console.log(plan);
    try {
      const response = await axios.get(
        `${baseurl}getPatientServiceById/${plan.id}`
      );
      if (response.data.success === true) {
        setServiceDatat(response.data.data);
      } else {
        console.log(response.data.data);
      }
    } catch (error) {
      console.log(error);
    }
  };

  return (
    <>
      <div className="col-12">
        <div className="row" style={{ marginTop: "30px" }}>
          <div className="col-8">
            <h5>Dental Chart (Click on Teeth to Select Multiple)</h5>
            <svg width="100%" height="210">
              {teethData.map((tooth, index) => {
                const x = (index % 16) * 45 + 20;
                const y = index < 16 ? 50 : 150;
                return (
                  <rect
                    key={tooth.id}
                    x={x}
                    y={y}
                    width="30"
                    height="50"
                    rx="5"
                    ry="5"
                    fill={selectedTeeth.includes(tooth.id) ? "orange" : "white"}
                    stroke="black"
                    onClick={() => handleClick(tooth)}
                    style={{ cursor: "pointer" }}
                  />
                );
              })}
            </svg>
          </div>
          <div className="col-4">
            {selectedTeeth.length > 0 ? (
              <div>
                <div className="d-flex justify-content-between align-items-center">
                  <div>
                    <h5>Selected Teeth</h5>
                  </div>
                  <div>
                    <button
                      type="button"
                      className="bgBtn"
                      onClick={ahndleclickopenservicemodal32}
                    >
                      Add Service
                    </button>
                  </div>
                </div>
                <ul className="list-unstyled">
                  {selectedTeeth.map((id) => {
                    const tooth = teethData.find((t) => t.id === id);
                    return (
                      <li key={id}>
                        <b>{tooth.id}:</b> {tooth.name}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ) : (
              "Please Select Teeth"
            )}
          </div>
          {serviceModalOpen && (
            <div
              className="modal fade show"
              style={{ display: "block" }}
              tabIndex="-1"
            >
              <div className="modal-dialog modal-lg">
                <div className="modal-content">
                  <div className="modal-header">
                    <h5 className="modal-title">
                      {selectedService ? "Edit Service" : "Add Service"}
                    </h5>
                    <button
                      type="button"
                      className="btn-close"
                      onClick={() => setServiceModalOpen(false)}
                    ></button>
                  </div>
                  <form onSubmit={handleServiceSubmit}>
                    <div className="modal-body">
                      <div className="row">
                        <div className="col-md-12 mb-3 position-relative">
                          <label className="form-label">
                            Search & Select Service
                          </label>
                          <input
                            type="text"
                            className="form-control"
                            placeholder="Type to search by name or code..."
                            value={searchServiceQuery}
                            onChange={(e) => {
                              setSearchServiceQuery(e.target.value);
                              setShowServiceSuggestions(true);
                            }}
                            onFocus={() => setShowServiceSuggestions(true)}
                          />
                          {showServiceSuggestions && (
                            <div
                              className="list-group shadow"
                              style={{
                                maxHeight: 240,
                                overflowY: "auto",
                                position: "absolute",
                                width: "100%",
                                zIndex: 1051,
                              }}
                            >
                              {filteredServices.length === 0 && (
                                <div className="list-group-item text-muted">
                                  No matches
                                </div>
                              )}
                              {filteredServices.map((service) => (
                                <button
                                  key={service.id}
                                  type="button"
                                  className={`list-group-item list-group-item-action ${
                                    service.id === serviceFormData.serviceId
                                      ? "active"
                                      : ""
                                  }`}
                                  onClick={() => {
                                    setServiceFormData({
                                      ...serviceFormData,
                                      serviceId: service.id,
                                    });
                                    setSearchServiceQuery(
                                      `${service.code} - ${service.serviceName}`
                                    );
                                    setShowServiceSuggestions(false);
                                  }}
                                >
                                  {service.code} - {service.serviceName} (
                                  {hasActiveInsuranceCard
                                    ? `BHD${
                                        service.insurancePrice ??
                                        service.insurance_price ??
                                        service.standardCost
                                      }`
                                    : `BHD${service.standardCost}`}
                                  )
                                </button>
                              ))}
                            </div>
                          )}
                        </div>
                        {(() => {
                          const s = availableServices.find(
                            (x) => x.id === serviceFormData.serviceId
                          );
                          return (
                            <>
                              <div className="col-md-3 mb-3">
                                <label className="form-label">Code</label>
                                <input
                                  className="form-control"
                                  value={s?.code || ""}
                                  readOnly
                                />
                              </div>
                              <div className="col-md-5 mb-3">
                                <label className="form-label">Name</label>
                                <input
                                  className="form-control"
                                  value={s?.serviceName || ""}
                                  readOnly
                                />
                              </div>
                              <div className="col-md-4 mb-3">
                                <label className="form-label">
                                  Selected Teeth Number
                                </label>
                                <div className="form-control" readOnly>
                                  {selectedTeeth.map((id) => {
                                    const tooth = teethData.find(
                                      (t) => t.id === id
                                    );
                                    return (
                                      <span
                                        key={id}
                                        className="badge bg-secondary me-1"
                                      >
                                        {tooth.id}
                                      </span>
                                    );
                                  })}
                                </div>
                              </div>
                              <div className="col-md-4 mb-3">
                                <label className="form-label">
                                  {hasActiveInsuranceCard
                                    ? "Insurance Cost"
                                    : "Standard Cost"}
                                </label>
                                <input
                                  className="form-control"
                                  value={
                                    hasActiveInsuranceCard
                                      ? s?.insurancePrice ??
                                        s?.insurance_price ??
                                        ""
                                      : s?.standardCost ?? ""
                                  }
                                  readOnly
                                />
                              </div>
                              <div className="col-md-3 mb-3">
                                <label className="form-label">VAT</label>
                                <input
                                  className="form-control"
                                  value={
                                    s
                                      ? s.vatEnabled
                                        ? `${s.vatValue}%`
                                        : "0%"
                                      : ""
                                  }
                                  readOnly
                                />
                              </div>
                              <div className="col-md-3 mb-3">
                                <label className="form-label">Total Cost</label>
                                <input
                                  className="form-control"
                                  placeholder="selected teeth * prise"
                                  value={
                                    hasActiveInsuranceCard
                                      ? s?.DentalMode === "multiple"
                                        ? s?.insurancePrice ??
                                          s?.insurance_price ??
                                          ""
                                        : (s?.insurancePrice ??
                                            s?.insurance_price ??
                                            "") * selectedTeeth.length
                                      : s?.DentalMode === "multiple"
                                      ? s?.standardCost ?? ""
                                      : (s?.standardCost ?? "") *
                                        selectedTeeth.length
                                  }
                                  readOnly
                                />
                              </div>
                              <div className="col-md-12 mb-3">
                                <label className="form-label">
                                  Description
                                </label>
                                <textarea
                                  className="form-control"
                                  rows="2"
                                  value={s?.description || ""}
                                  readOnly
                                />
                              </div>
                            </>
                          );
                        })()}

                        <div className="col-md-12 mb-3">
                          <label className="form-label">Extra Notes</label>
                          <textarea
                            className="form-control"
                            rows="3"
                            value={serviceFormData.extraNotes}
                            onChange={(e) =>
                              setServiceFormData({
                                ...serviceFormData,
                                extraNotes: e.target.value,
                              })
                            }
                          ></textarea>
                        </div>
                        <div className="col-md-6 mb-3">
                          <label className="form-label">Discount Type</label>
                          <select
                            className="form-select"
                            value={serviceFormData.discountType}
                            onChange={(e) =>
                              setServiceFormData({
                                ...serviceFormData,
                                discountType: e.target.value,
                              })
                            }
                          >
                            <option value="Amount">By Amount BHD</option>
                            <option value="Percentage">
                              By Percentage (%)
                            </option>
                          </select>
                        </div>
                        <div className="col-md-6 mb-3">
                          <label className="form-label">Discount Value</label>
                          <input
                            type="number"
                            className="form-control"
                            value={serviceFormData.discountValue}
                            onChange={(e) =>
                              setServiceFormData({
                                ...serviceFormData,
                                discountValue: parseFloat(e.target.value) || 0,
                              })
                            }
                            min="0"
                            step="0.01"
                          />
                        </div>
                        <div className="col-md-6 mb-3">
                          <label className="form-label">Surface</label>
                          <div className="form-check">
                            <input
                              type="checkbox"
                              className="form-check-input"
                              id="surfaceCheck"
                              checked={serviceFormData.surface === "Yes"}
                              onChange={() =>
                                setServiceFormData({
                                  ...serviceFormData,
                                  surface:
                                    serviceFormData.surface === "Yes"
                                      ? "No"
                                      : "Yes",
                                })
                              }
                            />
                            <label
                              className="form-check-label"
                              htmlFor="surfaceCheck"
                            >
                              {serviceFormData.surface === "Yes" ? "Yes" : "No"}
                            </label>
                          </div>
                        </div>
                        {serviceFormData.surface === "Yes" ? (
                          <div className="col-md-6 mb-3">
                            <label className="form-label">Teeth </label>
                            <input
                              className="form-control"
                              value={serviceFormData.surface_area_code}
                              onChange={(e) => {
                                if (e.target.value.length <= 5) {
                                  setServiceFormData({
                                    ...serviceFormData,
                                    surface_area_code: e.target.value,
                                  });
                                }
                              }}
                            ></input>
                          </div>
                        ) : (
                          ""
                        )}
                      </div>
                    </div>
                    <div className="modal-footer">
                      <button
                        type="button"
                        className="btn btn-secondary"
                        onClick={() => setServiceModalOpen(false)}
                      >
                        Cancel
                      </button>
                      <button type="submit" className="btn btn-primary">
                        {selectedService ? "Update" : "Add"} Service
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          )}
        </div>
        <div className="table-card">
          <div className="row">
            <div className="col-12">
              <div className="tableHeader">
                <div className="tableSearch  normalInputHeader">
                  <select
                    className="form-select"
                    onChange={handledategetsaddt}
                    // onChange={(e) => setSelectedDate(e.target.value)}
                    // value={dateqq}
                  >
                    <option>Select date</option>
                    {datta &&
                      datta.length > 0 &&
                      datta.map((item, index) => {
                        console.log(item);
                        return (
                          <>
                            <option key={index} value={item.created_at}>
                              {item?.split("T")[0]}
                            </option>
                          </>
                        );
                      })}
                  </select>
                </div>
              </div>
              <div className="p20">
                <div className="row g-3">
                  <div className="col-lg-12">
                    <div className="cardBorder">
                      <div className="tableHeader">
                        <div className="d-flex justify-content-between">
                          <h5>
                            <strong>Dental History</strong>
                          </h5>
                        </div>
                      </div>
                      <div className="table-responsive">
                        <table className="table">
                          <thead>
                            <tr>
                              <th>Sn</th>
                              <th>Service name </th>
                              <th>Amount</th>
                              <th>Discount Type</th>
                              <th>Teeth Number</th>
                              <th>Notes</th>
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            {patients && patients.length > 0 ? (
                              patients.map((plan, index) => {
                                console.log(plan);
                                return (
                                  <tr key={index}>
                                    <td>{index + 1}</td>
                                    <td>{plan?.service_name}</td>
                                    <td>{plan?.amount}</td>
                                    <td>{plan?.discount_type}</td>
                                    <td>{plan?.teeth_ids}</td>
                                    <td>{plan?.extra_notes}</td>
                                    {/* <td>
                                      <div className="avtar avtar-xs btn-link-secondary deleteIcon">
                                        <i
                                          className="ti ti-eye f-20 mx-2"
                                          style={{ cursor: "pointer" }}
                                          onClick={() => {
                                            hadlenavigatedelete(plan.group_id);
                                          }}
                                        ></i>
                                        <i
                                          className="ti ti-trash f-20"
                                          style={{ cursor: "pointer" }}
                                          onClick={() => {
                                            hadlenavigatedelete(plan.group_id);
                                          }}
                                        ></i>
                                        <span>Delete</span>
                                      </div>
                                    </td> */}
                                    <td>
                                      <div className="d-flex  justify-content-center">
                                        <div
                                          onClick={() => handleLabView(plan)}
                                          style={{ cursor: "pointer" }}
                                          className="avtar avtar-xs btn-link-secondary viewIcon"
                                        >
                                          <i className="ti ti-eye f-20" />
                                          <span>View</span>
                                        </div>
                                        {/* <div
                                                onClick={() =>
                                                  handleLabEdit(item)
                                                }
                                                style={{ cursor: "pointer" }}
                                                className="avtar avtar-xs btn-link-secondary editIcon"
                                              >
                                                <i className="ti ti-edit f-20" />
                                                <span>Edit</span>
                                              </div> */}
                                        {/* <div
                                                style={{ cursor: "pointer" }}
                                                className="avtar avtar-xs btn-link-secondary deleteIcon"
                                                onClick={() => {
                                            hadlenavigatedelete(plan.group_id);
                                          }}
                                              >
                                                <i className="ti ti-trash f-20" />
                                                <span>Delete</span>
                                              </div> */}
                                      </div>
                                    </td>
                                  </tr>
                                );
                              })
                            ) : (
