                                                    {plan?.illness_text ||
                                                      "N/A"}
                                                  </td>
                                                  <td className="text-center d-flex gap-2">
                                                    <button
                                                      type="button"
                                                      className="avtar avtar-xs btn-link-secondary editIcon"
                                                      onClick={() =>
                                                        openEditIllness(plan)
                                                      }
                                                      style={{
                                                        background: "none",
                                                        border: "none",
                                                        cursor: "pointer",
                                                      }}
                                                    >
                                                      <i className="ti ti-edit f-20" />
                                                      <span>Edit</span>
                                                    </button>

                                                    <button
                                                      type="button"
                                                      className="avtar avtar-xs btn-link-secondary deleteIcon"
                                                      onClick={() =>
                                                        openEditIllndelet(plan)
                                                      }
                                                      style={{
                                                        background: "none",
                                                        border: "none",
                                                        cursor: "pointer",
                                                      }}
                                                    >
                                                      <i className="ti ti-trash f-20" />
                                                      <span>Delete</span>
                                                    </button>
                                                  </td>
                                                </tr>
                                              )
                                            )
                                          ) : (
                                            <tr>
                                              <td
                                                colSpan="3"
                                                className="text-center"
                                              >
                                                N/A
                                              </td>
                                            </tr>
                                          )}
                                        </tbody>
                                        {editModalOpen && (
                                          <div
                                            className="modal fade show"
                                            style={{
                                              backgroundColor:
                                                "rgba(81, 81, 81, 0.5)",
                                              display: "block",
                                            }}
                                          >
                                            <div className="modal-dialog">
                                              <div className="modal-content p-0">
                                                <div className="modal-header">
                                                  <h5 className="modal-title">
                                                    Edit Chronic Illness
                                                  </h5>
                                                </div>
                                                <div className="modal-body">
                                                  <div className="row">
                                                    <div className="col-md-12">
                                                      <label className="form-label">
                                                        Title
                                                      </label>
                                                      <input
                                                        type="text"
                                                        name="illness_text"
                                                        value={
                                                          selectedIllness?.illness_text ||
                                                          ""
                                                        }
                                                        onChange={
                                                          handleEditChange
                                                        }
                                                        className="form-control"
                                                      />
                                                    </div>
                                                  </div>
