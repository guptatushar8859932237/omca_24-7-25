                                                        <>
                                                          <li
                                                            key={
                                                              item.id || index
                                                            }
                                                            style={{
                                                              padding: "8px",
                                                              cursor: "pointer",
                                                              borderBottom:
                                                                "1px solid #eee",
                                                              backgroundColor:
                                                                "#fff",
                                                            }}
                                                            onClick={() =>
                                                              handleSuggestionClick9(
                                                                item?.text
                                                              )
                                                            }
                                                          >
                                                            {item?.text}
                                                          </li>
                                                        </>
                                                      );
                                                    }
                                                  )}
                                                </ul>
                                              )}
                                            </div>
                                          </div>
                                        )}
                                      </div>
