                                                  </button>

                                                  <button
                                                    type="button"
                                                    className="avtar avtar-xs btn-link-secondary deleteIcon"
                                                    onClick={() =>
                                                      handleEditAlledelete(plan)
                                                    }
                                                    style={{
                                                      background: "none",
                                                      border: "none",
                                                      cursor: "pointer",
                                                    }}
                                                  >
                                                    <i className="ti ti-trash f-20" />
                                                    <span>Delete</span>
                                                  </button>
                                                </td>
                                              </tr>
                                            ))
