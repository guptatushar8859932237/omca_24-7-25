                                            <td>
                                              <div className="avtar avtar-xs btn-link-secondary editIcon">
                                                <i
                                                  className="ti ti-eye f-20"
                                                  style={{ cursor: "pointer" }}
                                                  onClick={() => {
                                                    hadlenavigate(
                                                      plan.group_id
                                                    );
                                                  }}
                                                ></i>
                                                <span>View</span>
                                              </div>
                                            </td>
                                            <td>
                                              <div className="avtar avtar-xs btn-link-secondary deleteIcon">
                                                <i
                                                  className="ti ti-trash f-20"
                                                  style={{ cursor: "pointer" }}
                                                  onClick={() => {
                                                    hadlenavigatedelete(
                                                      plan.group_id
                                                    );
                                                  }}
                                                ></i>
                                                <span>Delete</span>
                                              </div>
                                            </td>
                                          </tr>
                                        ))
                                      ) : (
                                        <tr>
                                          <td
                                            colSpan="6"
                                            className="text-center"
                                          >
                                            N/A
                                          </td>
                                        </tr>
                                      )}
                                    </tbody>
                                  </table>
                                </div>
                              </div>
                            </div>
                          </div>
                          <div className="col-lg-6 col-md-12 col-sm-12 col-12 ">
