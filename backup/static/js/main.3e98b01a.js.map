                                        Pain Assessment
                                        <i
                                          className="ti ti-edit f-20 ms-2"
                                          style={{ cursor: "pointer" }}
                                          onClick={handleChiefEditopnelmodal}
                                        ></i>
                                      </h5>
                                    </div>
