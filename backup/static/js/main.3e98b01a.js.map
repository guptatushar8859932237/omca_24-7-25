  const handleclickddappointment = async () => {
    if (!appointmentdata.appointmentDate) {
      Swal.fire({
        icon: "warning",
        title: "Missing Field",
        text: "Please select an appointment date.",
      });
      return;
    }
    if (!appointmentdata.startTime || !appointmentdata.endTime) {
      Swal.fire({
        icon: "warning",
        title: "Missing Fields",
        text: "Please select both start and end times.",
      });
      return;
    }
    const [startHour, startMinute] = appointmentdata.startTime
      .split(":")
      .map(Number);
    const [endHour, endMinute] = appointmentdata.endTime.split(":").map(Number);
    const startTotal = startHour * 60 + startMinute;
    const endTotal = endHour * 60 + endMinute;
    if (endTotal <= startTotal) {
      Swal.fire({
        icon: "warning",
        title: "Invalid Time Selection",
        text: "End time must be later than start time.",
      });
      return;
    }
    if (endTotal - startTotal < 10) {
      Swal.fire({
        icon: "warning",
        title: "Invalid Time Range",
        text: "End time must be at least 10 minutes after start time.",
      });
      return;
    }
    const localDate = new Date(appointmentdata?.appointmentDate);
    const formattedDate = localDate?.toLocaleDateString("en-CA", {
      timeZone: "Asia/Kolkata",
    });
