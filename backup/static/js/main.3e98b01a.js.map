import React, { useState, useEffect } from "react";
import GaugeChart from "react-gauge-chart";
export default function HalfPieChart({ painassesment }) {
  const [painLevel, setPainLevel] = useState(0); // Range: 0 to 1
  useEffect(() => {
    if (painassesment !== undefined && painassesment !== null) {
      setPainLevel(painassesment / 10);
    }
  }, [painassesment]);
  const handleChange = (e) => {
    const value = parseInt(e.target.value);
    setPainLevel(value / 10);
  };
  return (
<div className="gaugeMain" style={{ textAlign: "center" }}>
  <GaugeChart
    id="pain-gauge"
    nrOfLevels={10}
    arcsLength={Array(10).fill(0.1)}
    colors={[
      "#00ff00", "#66ff00", "#ccff00", "#ffff00", "#ffcc00",
      "#ff9900", "#ff6600", "#ff3300", "#ff0000", "#cc0000"
    ]}
    percent={painLevel}
    arcPadding={0.02}
    textColor="#3a2a2aff"
    formatTextValue={() => `Level: ${Math.round(painLevel * 10)}`}
    style={{ width: "250px" }}  // 👈 fix width here
  />
</div>

  );
}
