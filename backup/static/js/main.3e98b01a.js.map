                                                            <tr key={index}>
                                                              <td>
                                                                {index + 1}
                                                              </td>
                                                              <td>
                                                                {
                                                                  item.medicine_name
                                                                }
                                                              </td>
                                                              <td>
                                                                {item.dose}
                                                              </td>
                                                              <td>
                                                                {item.frequency}
                                                              </td>
                                                              <td>
                                                                {item.duration}
                                                              </td>
                                                              <td className="text-center">
                                                                <button
                                                                  className="btn btn-sm btn-warning me-2"
                                                                  onClick={() =>
                                                                    handleEditMedicine(
                                                                      index
                                                                    )
                                                                  }
                                                                >
                                                                  Edit
                                                                </button>
                                                                <button
                                                                  className="btn btn-sm btn-danger"
                                                                  onClick={() =>
                                                                    handleDeleteMedicine(
                                                                      index
                                                                    )
                                                                  }
                                                                >
                                                                  Delete
                                                                </button>
                                                              </td>
                                                            </tr>
                                                          </>
                                                        );
                                                      }
                                                    )
