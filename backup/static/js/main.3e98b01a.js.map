                                                      type="text"
                                                      name="illness_text"
                                                      placeholder="illness_text"
                                                      onChange={
                                                        handlechnageillbness
                                                      }
                                                      className="form-control"
                                                    />
                                                  </div>
                                                </div>
                                              </div>
                                              <div className="modal-footer justify-content-end">
