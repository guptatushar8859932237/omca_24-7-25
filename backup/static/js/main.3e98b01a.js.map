                                <div className="col-md-6">
                                  <label className="form-label">
                                    Weight (kg)
                                  </label>
                                  <input
                                    name="weight"
                                    value={formData.weight}
                                    disabled
                                    className="form-control"
                                    min="0"
                                    max="1000"
                                    step="0.1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">
                                    Height (cm)
                                  </label>
                                  <input
                                    name="height"
                                    value={formData.height}
                                    disabled
                                    className="form-control"
                                    min="0"
                                    max="300"
                                    step="0.1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">
                                    BMI (auto-calculated)
                                  </label>
                                  <input
                                    type="text"
                                    value={calculateBMI()}
                                    readOnly
                                    className="form-control bg-light"
                                  />
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">
                                    Risk of Fall
                                  </label>
                                  <br />
                                  {["Low", "Medium", "High"].map((option) => {
                                    const getColorClass = () => {
                                      if (formData.risk_of_fall !== option)
                                        return "";
                                      if (option === "High")
                                        return "text-danger";
                                      if (option === "Medium")
                                        return "text-warning";
                                      if (option === "Low")
                                        return "text-success";
                                    };
                                    return (
                                      <label
                                        className={`me-3 form-label ${getColorClass()}`}
                                        key={option}
                                      >
                                        <input
                                          type="radio"
                                          name="risk_of_fall"
                                          value={option}
                                          style={{ cursor: "pointer" }}
                                          checked={
                                            formData.risk_of_fall === option
                                          }
                                          disabled
                                        />{" "}
                                        {option}
                                      </label>
                                    );
                                  })}
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">Urgency</label>
                                  <br />
                                  {["Normal", "Moderate", "High"].map(
                                    (option) => {
                                      const getColorClass = () => {
                                        if (formData.urgency !== option)
                                          return "";
                                        if (option === "High")
                                          return "text-danger";
                                        if (option === "Moderate")
                                          return "text-warning";
                                        if (option === "Normal")
                                          return "text-success";
                                      };
                                      return (
                                        <label
                                          className={`me-3 form-label ${getColorClass()}`}
