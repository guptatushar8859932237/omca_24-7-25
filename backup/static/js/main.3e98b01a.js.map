  const [serviceListModal, setServiceListModal] = useState(false);
  const [selectedServicesForModal, setSelectedServicesForModal] = useState([]);

  const handleSeeMoreServices = (services) => {
    setSelectedServicesForModal(services || []);
    setServiceListModal(true);
  };

  const displayPlanTotal = planTotal || fallbackPlanTotal || 0;
  const displayCompletedTotal = completedTotal || fallbackCompletedTotal || 0;
  const formatBhd = (n) => `${Number(n || 0).toLocaleString("en-US")} BHD`;

  const fallbackPlanCount = safeServices.filter(
    (s) => (s.status || "").toString().toLowerCase() === "plan"
  ).length;
  const fallbackCompleteCount = safeServices.filter((s) => {
    const st = (s.status || "").toString().toLowerCase();
    return st === "complete" || st === "completed";
  }).length;
  const displayPlanCount = totalPlanServices || fallbackPlanCount;
  const displayCompleteCount = totalCompleteServices || fallbackCompleteCount;

  const handleAddService = () => {
    checkPatientInsuranceCard();
    setSelectedService(null);
    setServiceFormData({
      serviceId: "",
      extraNotes: "",
      discountType: "Amount",
      discountValue: 0,
      status: "Plan",
      customCost: "",
    });
    setSearchServiceQuery("");
    setShowServiceSuggestions(false);
    setServiceModalOpen(true);
  };

  const handleEditService = (service) => {
    setSelectedService(service);

    // Use the correct service ID field name
    const serviceId = service.serviceId || service.service_id;

    // Set the search query to show the selected service name
    const serviceData = availableServices.find((s) => s.id === serviceId);

    // Initialize customCost with the default cost based on insurance status
    let initialCost = "";
    if (serviceData) {
      initialCost = hasActiveInsuranceCard
        ? serviceData.insurancePrice ??
        serviceData.insurance_price ??
        serviceData.standardCost
        : serviceData.standardCost;
      initialCost = initialCost || "";
    }

    setSearchServiceQuery(
      serviceData
        ? `${serviceData.code} - ${serviceData.serviceName}`
        : `${service.serviceCode || service.service_code || ""} - ${service.serviceName || service.service_name || ""
        }`
    );

    setServiceFormData({
      serviceId: serviceId,
      extraNotes: service.extraNotes || service.extra_notes || "",
      discountType: service.discountType || service.discount_type || "Amount",
      discountValue: service.discount_value || service.discount_value || 0,
      status: service.status || "Plan",
      customCost: initialCost,
    });

    setShowServiceSuggestions(false);
    setServiceModalOpen(true);
  };

  const handleDeleteService = async (serviceId) => {
    const confirm = await Swal.fire({
      title: "Are you sure?",
      text: "This service will be removed from the patient!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonText: "Yes, remove it!",
    });

    if (confirm.isConfirmed) {
      try {
        await axios.delete(`${baseurl}deletePatientService/${serviceId}`);
        Swal.fire(
          "Removed!",
          "Service has been removed from patient.",
          "success"
        );
        loadPatientServices();
      } catch (error) {
        console.error("Delete failed", error);
        Swal.fire("Error", "Something went wrong!", "error");
      }
    }
  };

  const handleServiceSubmit = async (e) => {
    e.preventDefault();

    const resolvedPatientId = Number(patientId) || null;
    const resolvedServiceId = Number(serviceFormData.serviceId) || null;

    // More specific validation messages
    if (!resolvedPatientId) {
      Swal.fire(
        "Error",
        "Patient information is missing. Please refresh the page and try again.",
        "error"
      );
      return;
    }

    if (!resolvedServiceId) {
      Swal.fire(
        "Error",
        "Please select a service from the dropdown list before adding.",
        "error"
      );
      return;
    }

    const selectedServiceData = availableServices.find(
      (s) => Number(s.id) === resolvedServiceId
    );
    if (!selectedServiceData) {
      Swal.fire("Error", "Please select a valid service", "error");
      return;
    }

    // Frontend duplicate check removed per requirement to allow adding the same service multiple times

    // const discountLimit = await fetchDiscountLimit();

    // if(serviceFormData.discountType==="Percentage"){
    //   if(serviceFormData.discountValue > discountLimit){
    //     Swal.fire("Invalid Discount",`Percentage discount cannot exceed ${discountLimit}%`,'error');
    //     return;
    //   }
    // }

    // Refresh insurance status before computing discount based on base cost
    await checkPatientInsuranceCard();
    const baseCost = hasActiveInsuranceCard
      ? selectedServiceData.insurancePrice ??
      selectedServiceData.insurance_price ??
      selectedServiceData.standardCost
      : selectedServiceData.standardCost;

    const discount =
      serviceFormData.discountType === "Percentage"
        ? (baseCost * serviceFormData.discountValue) / 100
        : serviceFormData.discountValue;

    const serviceData = {
      serviceId: resolvedServiceId,
      discount_type: serviceFormData.discountType,
      discount_value: serviceFormData.discountValue,
      extra_notes: serviceFormData.extraNotes,
    };

    try {
      if (selectedService) {
        // Use UpdatePatientServices/:id for editing existing service record
        await axios.put(
          `${baseurl}UpdatePatientServices/${selectedService.id}`,
          serviceData
        );
        Swal.fire("Success", "Patient service updated successfully", "success");
      } else {
        // Keep add flow as-is
        await axios.post(`${baseurl}AddPatientServices`, {
          patientId: resolvedPatientId,
          ...serviceData,
        });
        Swal.fire("Success", "Service added successfully", "success");
      }
      setServiceModalOpen(false);
      loadPatientServices();
    } catch (error) {
      console.error("Submit failed", error);
      const msg = error.response?.data?.message || "Something went wrong!";
      Swal.fire("Error", msg, "error");
    }
  };

  const handleStatusChange = async (patientIdentifier, newStatus) => {
    try {
      const res = await axios.put(
        `${baseurl}updatePatientPharmacyStatus/${patientIdentifier}`,
        { status: newStatus }
      );
      if (res.data.success) {
        Swal.fire("Success", "Patient status updated successfully", "success");
      } else {
        Swal.fire(
          "Error",
          res.data.message || "failed to updated the status",
          "error"
        );
      }
    } catch (error) {
      console.error("Status change failed", error);
      Swal.fire("Error", "Something went wrong!", "error");
    }
  };

  // const truncateStyle = {
  //   maxWidth: "150px",
  //   whiteSpace: "nowrap",
  //   overflow: "hidden",
  //   textOverflow: "ellipsis",
  // };

  const handleServiceStatusChange = async (serviceId, newStatus) => {
    try {
      const res = await axios.put(
        `${baseurl}updatePatientServicesStatus/${serviceId}`,
        { status: newStatus }
      );
      if (res.data.success) {
        Swal.fire("Success", "Service status updated successfully", "success");
        loadPatientServices(); // Refresh the services list
      } else {
        Swal.fire(
          "Error",
          res.data.message || "Failed to update service status",
          "error"
        );
      }
    } catch (error) {
      console.error("Service status change failed", error);
      Swal.fire("Error", "Something went wrong!", "error");
    }
  };

  // Inventory functions
  const handleAddInventory = () => {
    setSelectedInventory(null);
    setInventoryFormData({
      inventoryId: "",
      quantity: 1,
    });
    setInventoryModalOpen(true);
  };

  const handleEditInventory = (item) => {
    setSelectedInventory(item);
    setInventoryFormData({
      inventoryId: item.drugId,
      quantity: item.quantity,
    });
    try {
      const inv = availableInventory.find((i) => i.id === item.drugId);
      if (inv) {
        setSearchInventoryQuery(`${inv.id} - ${inv.name}`);
      } else {
        setSearchInventoryQuery(`${item.drugId} - ${item.drug_name}`);
      }
    } catch (_) { }
    setInventoryModalOpen(true);
  };

  // Print functionality
  const handlePrintClick = () => {
    setIsSelectingForPrint(true);
    setSelectedPrintIds([]);
    setPrintModalOpen(true);
  };

  const handleServiceSelection = (serviceId) => {
    setSelectedPrintIds((prev) => {
      if (prev.includes(serviceId)) {
        return prev.filter((id) => id !== serviceId);
      } else {
        return [...prev, serviceId];
      }
    });
  };

  const handleSelectAllServices = () => {
    if (selectedPrintIds.length === safeServices.length) {
      setSelectedPrintIds([]);
    } else {
      setSelectedPrintIds(safeServices.map((service) => service.id));
    }
  };

  const handlePrintSelected = () => {
    if (selectedPrintIds.length === 0) {
      Swal.fire(
        "No Selection",
        "Please select at least one service to print",
        "warning"
      );
      return;
    }

    const selectedServices = safeServices.filter((service) =>
      selectedPrintIds.includes(service.id)
    );

    // Generate print content
    const printContent = generatePrintContent(selectedServices);
    printServices(printContent);

    setPrintModalOpen(false);
    setIsSelectingForPrint(false);
    setSelectedPrintIds([]);
  };

  const generatePrintContent = (services) => {
    const now = new Date();
    const currentDate =
      now.toLocaleDateString("en-US", {
        month: "2-digit",
        day: "2-digit",
        year: "numeric",
      }) +
      " " +
      now.toLocaleTimeString("en-US", {
        hour: "numeric",
        minute: "2-digit",
        hour12: true,
      });

    let content = `
        <div style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; padding: 20px;">
          <div style="text-align: center; margin-bottom: 30px; border-bottom: 2px solid #333; padding-bottom: 20px;">
            <h1 style="color: #333; margin: 0;">Patient Services Report</h1>
            <p style="margin: 5px 0; color: #666;">Generated on: ${currentDate}</p>
          </div>
          
          <div style="margin-bottom: 20px;">
            <h3 style="color: #333; border-bottom: 1px solid #ddd; padding-bottom: 10px;">Selected Services</h3>
          </div>
          
          <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
            <thead>
              <tr style="background-color: #f8f9fa;">
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">S.No</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">Date</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">Code</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">Service Name</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">Description</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">Cost</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">VAT</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">Discount</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">Net Amount</th>
                <th style="border: 1px solid #ddd; padding: 12px; text-align: left;">Status</th>
              </tr>
            </thead>
            <tbody>
      `;

    services.forEach((service, index) => {
      const serviceData = availableServices.find(
        (s) => s.id === (service.serviceId ?? service.service_id)
      );

      const vatDisplay = serviceData
        ? serviceData.vatEnabled
          ? `${serviceData.vatValue}%`
          : "0%"
        : service.vat_value
          ? `${service.vat_value}%`
          : "0%";
      const cost = hasActiveInsuranceCard
        ? serviceData?.insurancePrice ??
        serviceData?.insurance_price ??
        service.insurancePrice ??
        service.insurance_price ??
        0
        : serviceData?.standardCost || service.standardCost || 0;
      const discountDisplay =
        (service.discount_value ?? service.discount_value ?? 0) > 0
          ? (service.discountType || service.discount_type || "")
            .toString()
            .toLowerCase() === "percentage"
            ? `${service.discountValue ?? service.discount_value}%`
            : `-${service.discountValue ?? service.discount_value} BHD`
          : "-";
      const dateDisplay = (() => {
        const ts =
          service.createdAt ||
          service.created_at ||
          service.dateTime ||
          service.datetime;
        const d = ts ? new Date(ts) : null;
        return d && !isNaN(d.getTime())
          ? d.toLocaleDateString("en-US", {
            month: "2-digit",
            day: "2-digit",
            year: "numeric",
          }) +
          " " +
          d.toLocaleTimeString("en-US", {
            hour: "numeric",
            minute: "2-digit",
            hour12: true,
          })
          : "-";
      })();
      content += `
          <tr>
            <td style="border: 1px solid #ddd; padding: 10px;">${index + 1}</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${dateDisplay}</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${serviceData?.code || service.serviceCode || "-"
        }</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${serviceData?.serviceName || service.serviceName || "-"
        }</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${serviceData?.description || service.description || "-"
        }</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${cost} BHD</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${vatDisplay}</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${discountDisplay}</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${service.netAmount ?? service.net_amount
        } BHD</td>
            <td style="border: 1px solid #ddd; padding: 10px;">${service.status || "Plan"
        }</td>
          </tr>
        `;
    });
    const totalAmount = services.reduce(
      (sum, service) => sum + (service.netAmount ?? service.net_amount ?? 0),
      0
    );
    content += `
            </tbody>
          </table>
          <div style="margin-top: 30px; padding-top: 20px; border-top: 2px solid #333;">
            <div style="text-align: right;">
              <h3 style="color: #333; margin: 0;">Total Amount: ${totalAmount.toLocaleString(
      "en-US"
    )} BHD</h3>
            </div>
          </div>
        </div>
      `;
    return content;
  };
  const printServices = (content) => {
    const printWindow = window.open("", "_blank");
    printWindow.document.write(`
        <html>
          <head>
            <title></title>
            <style>
              @media print {
                body { margin: 0; }
                .no-print { display: none; }
              }
              body { font-family: Arial, sans-serif; }
            </style>
          </head>
          <body>
            ${content}
          </body>
        </html>
      `);
    printWindow.document.close();
    printWindow.focus();
    setTimeout(() => {
      printWindow.print();
      printWindow.close();
    }, 500);
  };
  const filteredServices = availableServices.filter(
    (service) =>
      service.serviceName
        ?.toLowerCase()
        .includes(searchServiceQuery.toLowerCase()) ||
      service.code?.toLowerCase().includes(searchServiceQuery.toLowerCase())
  );
  const filteredInventory = availableInventory.filter(
    (item) =>
      item.name?.toLowerCase().includes(searchInventoryQuery.toLowerCase()) ||
      item.id?.toString().includes(searchInventoryQuery)
  );
  const filteredServicesTable = safeServices.filter((service) => {
    if (!serviceTableSearchTerm) return true;
    const q = serviceTableSearchTerm.toLowerCase();
    const serviceData = availableServices.find(
      (s) => s.id === (service.serviceId ?? service.service_id)
    );
    return (
      (serviceData?.code && serviceData.code.toLowerCase().includes(q)) ||
      (serviceData?.serviceName &&
        serviceData.serviceName.toLowerCase().includes(q)) ||
      (serviceData?.description &&
        serviceData.description.toLowerCase().includes(q)) ||
      (service.serviceCode && service.serviceCode.toLowerCase().includes(q)) ||
      (service.serviceName && service.serviceName.toLowerCase().includes(q)) ||
      (service.description && service.description.toLowerCase().includes(q)) ||
      (service.extra_notes && service.extra_notes.toLowerCase().includes(q)) ||
      (service.status && service.status.toLowerCase().includes(q))
    );
  });
  const safeInventoryItems = Array.isArray(inventoryItems)
    ? inventoryItems
    : [];
  const filteredInventoryTable = safeInventoryItems.filter((item) => {
    if (!inventoryTableSearchTerm) return true;
    const q = inventoryTableSearchTerm.toLowerCase();
    return (
      (item.drug_name && item.drug_name.toLowerCase().includes(q)) ||
      (item.drugId && item.drugId.toString().includes(q)) ||
      (item.quantity && item.quantity.toString().includes(q)) ||
      (item.status && item.status.toLowerCase().includes(q))
    );
  });
  const totalServicePages =
    Math.ceil(filteredServicesTable.length / servicesPerPage) || 1;
  const totalInventoryPages =
    Math.ceil(filteredInventoryTable.length / inventoryPerPage) || 1;
  const paginatedServices = filteredServicesTable.slice(
    (currentServicePage - 1) * servicesPerPage,
    currentServicePage * servicesPerPage
  );
  const paginatedInventory = filteredInventoryTable.slice(
    (currentInventoryPage - 1) * inventoryPerPage,
    currentInventoryPage * inventoryPerPage
  );
  // Reset to first page if dataset size changes
  useEffect(() => {
    setCurrentServicePage(1);
  }, [services.length]);
  useEffect(() => {
    setCurrentInventoryPage(1);
  }, [safeInventoryItems.length]);
  const downloadLargePDF = async (divId) => {
    const input = document.getElementById(divId);
    const pdf = new jsPDF("p", "mm", "a4");
    const pageHeight = 295;
    const pageWidth = 210;
    const canvas = await html2canvas(input, {
      scale: 2,
      useCORS: true,
    });
    const imgData = canvas.toDataURL("image/png");
    const imgHeight = (canvas.height * pageWidth) / canvas.width;
    let heightLeft = imgHeight;
    let position = 0;
    pdf.addImage(imgData, "PNG", 0, position, pageWidth, imgHeight);
    heightLeft -= pageHeight;
    while (heightLeft > 0) {
      position = heightLeft - imgHeight;
      pdf.addPage();
      pdf.addImage(imgData, "PNG", 0, position, pageWidth, imgHeight);
      heightLeft -= pageHeight;
    }
    pdf.save("download.pdf");
  };
  return (
    <div className="pc-container">
      <div className="pc-content">
        <div className="patientTab">
          <div>
            <ul
              className="nav justify-content-between nav-tabs"
              id="myTab"
              role="tablist"
            >
              <li className="nav-item" role="presentation">
                <button
                  className={`nav-link ${activeTab === 'personaldata' ? 'active' : ''}`}
                  id="personaldata-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#personaldata"
                  type="button"
                  role="tab"
                  aria-controls="personaldata"
                  aria-selected={activeTab === 'personaldata'}
                  disabled={!hasSubModulePermission(2)}
                  style={{
                    opacity: !hasSubModulePermission(2) ? 0.5 : 1,
                    cursor: !hasSubModulePermission(2) ? 'not-allowed' : 'pointer',
                    pointerEvents: !hasSubModulePermission(2) ? 'none' : 'auto',
                    display: !hasSubModulePermission(2) ? 'none' : 'flex'
                  }}
                >
                  <span>
                    <div className="tabSvg">
                      <i class="fas fa-server"></i>
                    </div>
                  </span>{" "}
                  <p>Personal Data</p>
                </button>
              </li>
              <li className="nav-item" role="presentation">
                <button
                  className={`nav-link ${activeTab === 'Appointment' ? 'active' : ''}`}
                  id="Appointment-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#Appointment"
                  type="button"
                  role="tab"
                  aria-controls="Appointment"
                  aria-selected={activeTab === 'Appointment'}
                  disabled={!hasSubModulePermission(3)}
                  style={{
                    opacity: !hasSubModulePermission(3) ? 0.5 : 1,
                    cursor: !hasSubModulePermission(3) ? 'not-allowed' : 'pointer',
                    pointerEvents: !hasSubModulePermission(3) ? 'none' : 'auto',
                    display: !hasSubModulePermission(3) ? 'none' : 'flex'
                  }}
                >
                  <div className="tabSvg">
                    <i class="far fa-calendar-check"></i>
                  </div>
                  <p>Appointment</p>
                </button>
              </li>
              <li className="nav-item" role="presentation">
                <button
                  className={`nav-link ${activeTab === 'vitalsings' ? 'active' : ''}`}
                  id="vitalsings-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#vitalsings"
                  type="button"
                  role="tab"
                  aria-controls="vitalsings"
                  aria-selected={activeTab === 'vitalsings'}
                  disabled={!hasSubModulePermission(4)}
                  style={{
                    opacity: !hasSubModulePermission(4) ? 0.5 : 1,
                    cursor: !hasSubModulePermission(4) ? 'not-allowed' : 'pointer',
                    pointerEvents: !hasSubModulePermission(4) ? 'none' : 'auto',
                    display: !hasSubModulePermission(4) ? 'none' : 'flex'
                  }}
                >
                  <div className="tabSvg">
                    <i class="fas fa-procedures"></i>
                  </div>
                  <p>Vital Signs</p>
                </button>
              </li>

              <li className="nav-item" role="presentation">
                <button
                  className={`nav-link ${activeTab === 'forms' ? 'active' : ''}`}
                  id="forms-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#forms"
                  type="button"
                  role="tab"
                  aria-controls="forms"
                  aria-selected={activeTab === 'forms'}
                  disabled={!hasSubModulePermission(5)}
                  style={{
                    opacity: !hasSubModulePermission(5) ? 0.5 : 1,
                    cursor: !hasSubModulePermission(5) ? 'not-allowed' : 'pointer',
                    pointerEvents: !hasSubModulePermission(5) ? 'none' : 'auto',
                    display: !hasSubModulePermission(5) ? 'none' : 'flex'
                  }}
                >
                  <div className="tabSvg">
                    <i class="fas fa-file-alt"></i>
                  </div>
                  <p>Forms</p>
                </button>
              </li>

              <li className="nav-item" role="presentation">
                <button
                  className={`nav-link ${activeTab === 'labs' ? 'active' : ''}`}
                  id="labs-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#labs"
                  type="button"
                  role="tab"
                  aria-controls="labs"
                  aria-selected={activeTab === 'labs'}
                  disabled={!hasSubModulePermission(6)}
                  style={{
                    opacity: !hasSubModulePermission(6) ? 0.5 : 1,
                    cursor: !hasSubModulePermission(6) ? 'not-allowed' : 'pointer',
                    pointerEvents: !hasSubModulePermission(6) ? 'none' : 'auto',
                    display: !hasSubModulePermission(6) ? 'none' : 'flex'
                  }}
                >
                  <div className="tabSvg">
                    <i class="fas fa-flask"></i>
                  </div>
                  <p>Labs</p>
                </button>
              </li>
              <li className="nav-item" role="presentation">
                <button
                  className={`nav-link ${activeTab === 'medicalhistory' ? 'active' : ''}`}
                  id="medicalhistory-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#medicalhistory"
                  type="button"
                  role="tab"
                  aria-controls="medicalhistory"
                  aria-selected={activeTab === 'medicalhistory'}
                  disabled={!hasSubModulePermission(7)}
                  style={{
                    opacity: !hasSubModulePermission(7) ? 0.5 : 1,
                    cursor: !hasSubModulePermission(7) ? 'not-allowed' : 'pointer',
                    pointerEvents: !hasSubModulePermission(7) ? 'none' : 'auto',
                    display: !hasSubModulePermission(7) ? 'none' : 'flex'
                  }}
                >
                  <div className="tabSvg">
                    <i class="fas fa-file-medical"></i>
                  </div>
                  <p>Medical History</p>
                </button>
              </li>
              <li className="nav-item" role="presentation">
                <button
                  className={`nav-link ${activeTab === 'dental' ? 'active' : ''}`}
                  id="dental-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#dental"
                  type="button"
                  role="tab"
                  aria-controls="dental"
                  aria-selected={activeTab === 'dental'}
                  disabled={!hasSubModulePermission(8)}
                  style={{
                    opacity: !hasSubModulePermission(8) ? 0.5 : 1,
                    cursor: !hasSubModulePermission(8) ? 'not-allowed' : 'pointer',
                    pointerEvents: !hasSubModulePermission(8) ? 'none' : 'auto',
                    display: !hasSubModulePermission(8) ? 'none' : 'flex'
                  }}
                >
                  <div className="tabSvg">
                    <i class="fas fa-tooth"></i>
                  </div>
                  <p>Dental</p>
                </button>
              </li>
              <li className="nav-item" role="presentation">
                <button
                  className={`nav-link ${activeTab === 'service' ? 'active' : ''}`}
                  id="service-tab"
                  data-bs-toggle="tab"
