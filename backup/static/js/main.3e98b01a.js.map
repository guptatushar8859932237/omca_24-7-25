      } else {
        Swal.fire(
          "Error",
          response.data?.message || "Something went wrong",
          "error"
        );
      }
    } catch (error) {
      console.error("API Error:", error);
      if (error.response?.data) {
        const errData = error.response.data;
        if (Array.isArray(errData?.errors)) {
          const formattedErrors = errData.errors
            .map((err) => `• ${err.msg || err}`)
            .join("<br/>");
          Swal.fire({
            icon: "error",
            title: "Validation Errors",
            html: formattedErrors,
          });
          return;
        }
        if (typeof errData?.message === "string") {
          Swal.fire("Error", errData.message, "error");
          return;
        }
        if (typeof errData === "object") {
          const formatted = Object.entries(errData)
            .map(([key, val]) => `• ${key}: ${val}`)
            .join("<br/>");
          Swal.fire({ icon: "error", title: "Errors", html: formatted });
          return;
        }
      }
      Swal.fire("Error", "Network error or server not responding", "error");
    }
