                                                isSearchable
                                                isClearable
                                                options={icdList1}
                                                value={selectedIcd1}
                                                onChange={handleNameChange}
                                                onInputChange={(value) => {
                                                  setInputValue1(value);
                                                  if (value.length >= 2) {
                                                    getdataicd11(value);
                                                  } else {
                                                    setIcdList1([]);
                                                  }
                                                }}
                                                placeholder="Search by ICD Name..."
                                                noOptionsMessage={() =>
                                                  inputValue1.length < 2
                                                    ? "Type at least 3 characters..."
                                                    : "No results"
                                                }
                                              />
                                            </div>
                                            <div className="mb-2 col-12">
                                              <label className="form-label">
