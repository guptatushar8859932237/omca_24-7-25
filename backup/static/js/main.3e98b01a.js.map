                                              <label className="form-label">
                                                Notes
                                              </label>
                                              <input
                                                className="form-control"
                                                name="notes"
                                                value={medicineData.notes}
                                                onChange={handleMedicineChange}
                                                placeholder="notes"
                                              />
                                            </div>
                                            <div className="col-6">
                                              <label className="form-label">
                                                Form
                                              </label>
                                              <input
                                                className="form-control"
                                                name="form"
                                                value={medicineData.form}
                                                onChange={handleMedicineChange}
                                                placeholder="form"
                                              />
                                            </div>
                                            <div className="col-6">
                                              <label className="form-label">
                                                Active Substances
                                              </label>
                                              <input
                                                className="form-control"
                                                name="substance"
                                                value={medicineData.substance}
                                                onChange={handleMedicineChange}
                                                placeholder="Substance"
