      const response = await axios.post(`${baseurl}addPrescription`, obj);

      // Handle missing or invalid response
      if (!response || !response.data) {
        Swal.fire("Error", "Invalid server response", "error");
        return;
      }

      // Success response
      if (response.data.success === true) {
        handlemodaldiagoniseclose();

        Swal.fire("Success", "Prescription added successfully", "success");

        getdatamedical();
        getDataa1();
      } else {
        // Backend returned success: false
        Swal.fire(
          "Error",
          response.data?.message || "Something went wrong",
          "error"
        );
      }
    } catch (err) {
      console.error("API Error:", err);

      // Axios error with response (server error)
      if (err.response) {
        Swal.fire(
          "Error",
          err.response.data?.message || "Server returned an error",
          "error"
        );
      }
      // No response (network error)
      else if (err.request) {
        Swal.fire(
          "Network Error",
          "Unable to reach server. Check your internet connection.",
          "error"
        );
      }
      // Something else (unexpected error)
      else {
        Swal.fire("Error", err.message || "Unexpected error occurred", "error");
      }
    }
  };

