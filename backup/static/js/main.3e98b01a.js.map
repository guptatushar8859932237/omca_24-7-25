                                                name="productType"
                                                value={medicineData.productType}
                                                onChange={handleMedicineChange}
                                                placeholder="productType"
                                              />
                                            </div>
                                            <div className="col-6">
                                              <label className="form-label">
                                                Pack Size
                                              </label>
                                              <input
                                                className="form-control"
                                                name="packet_size"
                                                value={medicineData.packet_size}
                                                onChange={handleMedicineChange}
                                                placeholder="packet_size"
                                              />
                                            </div>
                                            <div className="col-6">
                                              <label className="form-label">
                                                Route
                                              </label>
                                              <input
                                                className="form-control"
                                                name="route"
                                                value={medicineData.route}
                                                onChange={handleMedicineChange}
                                                placeholder="Route"
                                              />
                                            </div>
                                            <div className="col-6">
                                              <label className="form-label">
                                                Strength
                                              </label>
                                              <input
                                                className="form-control"
                                                name="strength"
