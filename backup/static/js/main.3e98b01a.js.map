                                      >
                                        <input
                                          type="radio"
                                          name="risk_of_fall"
                                          value={option}
                                          style={{ cursor: "pointer" }}
                                          checked={
                                            formData.risk_of_fall === option
                                          }
                                          onChange={handleChange}
                                        />{" "}
                                        {option}
                                      </label>
                                    );
                                  })}
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">Urgency</label>
                                  <br />
                                  {["Normal", "Moderate", "High"].map(
                                    (option) => {
                                      const getColorClass = () => {
                                        if (formData.urgency !== option)
                                          return "";
                                        if (option === "High")
                                          return "text-danger";
                                        if (option === "Moderate")
                                          return "text-warning";
                                        if (option === "Normal")
                                          return "text-success";
                                      };
                                      return (
