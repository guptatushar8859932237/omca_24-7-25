                                            <div className="col-6">
                                              <label className="form-label">
                                                Frequency
                                              </label>
                                              <input
                                                className="form-control"
                                                name="frequency"
                                                value={medicineData.frequency}
                                                onChange={handleMedicineChange}
                                                placeholder="Frequency"
                                              />
                                            </div>
                                          </div>

                                          <div className="row">
                                            <div className=" col-6">
