                                              {new Date(
                                                plan?.prescribed_at
                                              ).toLocaleDateString("en-GB")}
                                            </td>
                                            <td>
                                              {plan?.prescribed_at
                                                ? new Date(
                                                  plan?.prescribed_at
                                                ).toLocaleTimeString(
                                                  "en-US",
                                                  {
                                                    hour: "2-digit",
                                                    minute: "2-digit",
                                                    hour12: true,
                                                  }
                                                )
                                                : ""}
