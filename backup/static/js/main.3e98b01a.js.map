                                <div
                                  className="modal fade show"
                                  style={{
                                    backgroundColor: "rgba(81, 81, 81, 0.5)",
                                    display: "block",
                                  }}
                                >
                                  <div className="modal-dialog modal-lg">
                                    <div className="modal-content ">
                                      <div className="modalScroll">
                                        <div className="modal-header">
                                          <h5 className="modal-title">
                                            Add Prescription
                                          </h5>
                                        </div>
                                        <div className="modal-body">
                                          <div className="row">
                                            <div className="col-6">
                                              <label className="form-label">
                                                Medicine (from List)
                                              </label>
                                              <Select
                                                isSearchable
                                                name="rxId"
                                                options={rxList.map((item) => ({
                                                  value: item.rxId,
                                                  label: item.medicineName,
                                                  strength: item.strength,
                                                  unit: item.unit,
                                                  packet_size: item.packet_size,
                                                  activeSubstances:
                                                    item.activeSubstances,
                                                }))}
                                                value={
                                                  rxList.find(
                                                    (item) =>
                                                      item.rxId ===
                                                      medicineData?.rxId
                                                  )
                                                    ? {
                                                      value:
                                                        medicineData.rxId,
                                                      label: rxList.find(
                                                        (item) =>
                                                          item.rxId ===
                                                          medicineData.rxId
                                                      ).medicineName,
                                                      strength: rxList.find(
                                                        (item) =>
                                                          item.rxId ===
                                                          medicineData.rxId
                                                      ).strength,
                                                      unit: rxList.find(
                                                        (item) =>
                                                          item.rxId ===
                                                          medicineData.rxId
                                                      ).unit,
                                                      packet_size:
                                                        rxList.find(
                                                          (item) =>
                                                            item.rxId ===
                                                            medicineData.rxId
                                                        ).packet_size,
                                                      activeSubstances:
                                                        rxList.find(
                                                          (item) =>
                                                            item.rxId ===
                                                            medicineData.rxId
                                                        ).activeSubstances,
                                                    }
                                                    : null
                                                }
                                                onChange={
                                                  handleEditLabChange123
                                                }
                                                classNamePrefix="select"
                                                placeholder="Select Medicine"
                                                // 👇 Custom UI for each option
                                                formatOptionLabel={(data) => (
                                                  <div
                                                    style={{
                                                      display: "flex",
                                                      flexDirection: "column",
                                                    }}
                                                  >
                                                    <strong
                                                      style={{
                                                        fontSize: "14px",
                                                        color: "#333",
                                                      }}
                                                    >
                                                      {data.label}
                                                    </strong>
                                                    <small
                                                      style={{ color: "#666" }}
                                                    >
                                                      {data.strength &&
                                                        `${data.strength}| `}
                                                      {data.unit && data.unit}
                                                    </small>
                                                    <small
                                                      style={{ color: "#888" }}
                                                    >
                                                      {data.packet_size}
                                                    </small>
                                                    <small
                                                      style={{ color: "#888" }}
                                                    >
                                                      {data.activeSubstances}
                                                    </small>
                                                  </div>
                                                )}
                                                // 👇 Custom search filter (searches all fields)
                                                filterOption={(
                                                  option,
                                                  inputValue
                                                ) => {
                                                  const searchText =
                                                    inputValue.toLowerCase();
                                                  return (
                                                    option.data.label
                                                      .toLowerCase()
                                                      .includes(searchText) ||
                                                    (option.data.strength &&
                                                      option.data.strength
                                                        .toLowerCase()
                                                        .includes(
                                                          searchText
                                                        )) ||
                                                    (option.data.substance &&
                                                      option.data.substance
                                                        .toLowerCase()
                                                        .includes(
                                                          searchText
                                                        )) ||
                                                    (option.data.packet_size &&
                                                      option.data.packet_size
                                                        .toLowerCase()
                                                        .includes(
                                                          searchText
                                                        )) ||
                                                    (option.data
                                                      .activeSubstances &&
                                                      option.data.activeSubstances
                                                        .toLowerCase()
                                                        .includes(searchText))
                                                  );
                                                }}
                                              />
                                            </div>

                                            <div className=" col-6">
                                              <label className="form-label">
                                                Medicine Name
                                              </label>
                                              <input
                                                className="form-control"
