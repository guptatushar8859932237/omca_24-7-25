                                    </thead>
                                    <tbody>
                                      {addedMedicines.length > 0 ? (
                                        addedMedicines.map((item, index) => {
                                          return (
                                            <>
                                              <tr key={index}>
                                                <td>{index + 1}</td>
                                                <td>{item.medicine_name}</td>
                                                <td>{item.dose}</td>
                                                <td>{item.frequency}</td>
                                                <td>{item.duration}</td>
                                                <td className="text-center">
                                                  <button
                                                    className="btn btn-sm btn-warning me-2"
                                                    onClick={() =>
                                                      handleEditMedicine(index)
                                                    }
                                                  >
                                                    Edit
                                                  </button>
                                                  <button
                                                    className="btn btn-sm btn-danger"
                                                    onClick={() =>
                                                      handleDeleteMedicine(
                                                        index
                                                      )
                                                    }
                                                  >
                                                    Delete
                                                  </button>
                                                </td>
                                              </tr>
                                            </>
                                          );
                                        })
                                      ) : (
                                        <tr>
                                          <td
                                            colSpan="3"
                                            className="text-center"
                                          >
                                            N/A
                                          </td>
                                        </tr>
                                      )}
                                    </tbody>
                                  </table>
                                </div>
                              </div>
                            </div>
                            <div className="modal-footer justify-content-end">
                              <button
                                type="button"
                                className="cancelText"
                                onClick={handlemodaldiagoniseclose}
                              >
                                Cancel
                              </button>
                              <button
                                type="button"
                                className="bgBtn"
                                onClick={handlesubmitprescription}
                              >
                                Submit Prescription
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                  {openlabModal && (
                    <div
                      className="modal fade show"
                      style={{
                        backgroundColor: "rgba(81, 81, 81, 0.5)",
                        display: "block",
                      }}
                    >
                      <div className="modal-dialog modal-lg">
                        <div className="modal-content ">
                          <div className="modalScroll">
                            <div className="modal-header">
                              <h5 className="modal-title">View Service</h5>
                            </div>
                            <div className="modal-body">
                              <div className="row"></div>
                              <div className="row">
                                <div className="col-6">
                                  <label className="form-label">Amount</label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.amount}
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">Status</label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.billing_status}
                                  />
                                </div>
                              </div>

                              <div className="row">
                                <div className=" col-6">
                                  <label className="form-label">
                                    Description
                                  </label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.description}
                                  />
                                </div>
                                <div className=" col-6">
                                  <label className="form-label">
                                    Discount Type
                                  </label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.discount_type}
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">
                                    Discount Value
                                  </label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.discount_value}
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">
                                    Extra Notes
                                  </label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.extra_notes}
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">
                                    Net Amount
                                  </label>
                                  <input
                                    className="form-control"
                                    value={serviceDatat.net_amount}
                                    disabled
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">
                                    Service Code
                                  </label>
                                  <input
                                    className="form-control"
                                    value={serviceDatat.serviceCode}
                                    disabled
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">
                                    Service Name
                                  </label>
                                  <input
                                    className="form-control"
                                    value={serviceDatat.serviceName}
                                    disabled
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">
                                    Standard Cost
                                  </label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.standardCost}
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">Status</label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.status}
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">
                                    Surface Code
                                  </label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.surface_area_code}
                                  />
                                </div>
                                <div className="col-6">
                                  <label className="form-label">
                                    Teeth Number{" "}
                                  </label>
                                  <input
                                    className="form-control"
                                    disabled
                                    value={serviceDatat.teeth_ids}
                                  />
                                </div>
                              </div>
                            </div>
                            <div className="modal-footer justify-content-end">
                              <button
                                type="button"
                                className="cancelText"
                                onClick={() => {
                                  setOpenlabModal(false);
                                }}
                              >
                                Cancel
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                  {prescriAllergy && (
                    <div
                      className="modal fade show"
                      style={{
                        backgroundColor: "rgba(81, 81, 81, 0.5)",
                        display: "block",
                      }}
                    >
                      <div className="modal-dialog modal-lg">
                        <div className="modal-content ">
                          <div className="modalScroll">
                            <div className="modal-header">
                              <h5 className="modal-title">
                                {isEditingXray ? "Edit Allergy" : "Add Allergy"}
                              </h5>
                            </div>
                            <div className="modal-body">
                              <div className="row">
                                <div className=" col-6">
                                  <label className="form-label">
                                    Enter Allergy{" "}
                                  </label>
                                  <input
                                    className="form-control"
                                    name="Allergy"
                                    value={allerytext.Allergy}
                                    onChange={andlechangeallergy}
                                    placeholder="Enter Allergy"
                                  />
                                </div>
                                <div className=" col-6">
                                  <label className="form-label">
                                    Enter Description
                                  </label>
                                  <input
                                    className="form-control"
                                    name="description"
                                    value={allerytext.description}
                                    onChange={andlechangeallergy}
                                    placeholder="Description"
                                  />
                                </div>
                              </div>
                            </div>
                            <div className="modal-footer justify-content-end">
                              <button
                                type="button"
                                className="cancelText"
                                onClick={() => {
                                  setPrescriAllergy(false);
                                }}
                              >
                                Cancel
                              </button>
                              <button
                                type="button"
                                className="bgBtn"
                                onClick={handlesubmitprescription11allergy}
                              >
                                {isEditingXray
                                  ? "Edit Allergy"
                                  : "Submit Allergy"}
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </>
  );
}
