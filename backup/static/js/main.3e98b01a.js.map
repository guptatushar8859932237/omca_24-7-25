  const handleAddLabAttachment = async () => {
    if (
      !editLabData.newAttachment ||
      !editLabData.attachmentName ||
      !editLabData.attachmentStatus
    ) {
      Swal.fire("Error", "Please fill all attachment fields", "error");
      return;
    }
    try {
      const formData = new FormData();
      formData.append("file", editLabData.newAttachment);
      formData.append("name", editLabData.attachmentName);
      formData.append("report_status", editLabData.attachmentStatus);
      const response = await axios.post(
        `${baseurl}addLabRequestAttachment/${editLabData.request_id}`,
        formData,
        {
          headers: { "Content-Type": "multipart/form-data" },
        }
      );
      if (response.data.success) {
        const res = await axios.get(
          `${baseurl}getLabRequestAttachmentsByLabRequestId/${editLabData.request_id}`
        );
        if (res.data.success) {
          setEditLabAttachments(res.data.data);
          console.log("Updated editLabAttachments:", res.data.data);
        }
        setEditLabData((prev) => ({
          ...prev,
          newAttachment: null,
          attachmentName: "",
          attachmentStatus: "",
        }));
        Swal.fire("Success", "Attachment added successfully", "success");
      } else {
        Swal.fire(
          "Error",
          response.data.message || "Failed to add attachment",
          "error"
        );
      }
