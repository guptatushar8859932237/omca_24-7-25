                                    <div
                                      className="modal fade show"
                                      style={{
                                        backgroundColor:
                                          "rgba(81, 81, 81, 0.5)",
                                        display: "block",
                                      }}
                                    >
                                      <div className="modal-dialog modal-lg">
                                        <div className="modal-content">
                                          <div className="modal-header">
                                            <h5 className="modal-title">
                                              {isEditingXray
                                                ? "Edit Xray & Radiology"
                                                : "Add Xray & Radiology"}
                                            </h5>
                                          </div>
                                          <div className="modal-body">
                                            <div className="row">
                                              <div className="col-md-6">
                                                <label className="form-label">
                                                  Title
                                                </label>
                                                <input
                                                  type="text"
                                                  name="Title"
                                                  placeholder="Title"
                                                  value={dataxray.Title}
                                                  onChange={handlechangeXray}
                                                  className="form-control"
                                                />
                                              </div>
                                              <div className="col-md-6">
                                                <label className="form-label">
                                                  Upload File
                                                </label>
                                                <input
                                                  type="file"
                                                  name="attachment"
                                                  onChange={handlechangeXray}
                                                  className="form-control"
                                                />
                                              </div>
                                              <div className="col-md-12">
                                                <label className="form-label">
                                                  Description
                                                </label>
                                                <input
                                                  type="text"
                                                  name="description"
                                                  placeholder="Description"
                                                  value={dataxray.description}
                                                  onChange={handlechangeXray}
                                                  className="form-control"
                                                />
                                              </div>
                                            </div>
                                          </div>
                                          <div className="modal-footer justify-content-end">
                                            <button
                                              type="button"
                                              className="cancelText"
                                              onClick={closexray}
                                            >
                                              Cancel
                                            </button>
                                            {isEditingXray ? (
                                              <button
                                                type="button"
                                                className="bgBtn"
                                                onClick={updateXray}
                                              >
                                                Update
                                              </button>
                                            ) : (
                                              <button
                                                type="button"
                                                className="bgBtn"
                                                onClick={Addreport}
                                              >
                                                Add
                                              </button>
                                            )}
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  )}
                                  <h5>Xray & Radiology</h5>
                                  <div
                                    className="addBtnIcon"
                                    onClick={openxray}
                                    style={{ cursor: "pointer" }}
                                  >
                                    <i class="borderBtn ti ti-plus f-20"></i>
                                  </div>
                                </div>
                              </div>
                              <div className="card-body p-0 bg-white rounded-bottom-4">
                                <div className="table-responsive">
                                  <table className="table">
                                    <thead>
                                      <tr>
                                        <th>Sn</th>
                                        <th>Date</th>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>File</th>
