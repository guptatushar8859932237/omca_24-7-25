                                    {allergy && (
                                      <div
                                        className="modal fade show"
                                        style={{
                                          backgroundColor:
                                            "rgba(81, 81, 81, 0.5)",
                                          display: "block",
                                        }}
                                      >
                                        <div className="modal-dialog ">
                                          <div className="modal-content">
                                            <div className="modal-header">
                                              <h5 className="modal-title">
                                                {isEditing9
                                                  ? "Edit Allergy"
                                                  : "Add Allergy"}
                                              </h5>
                                            </div>
                                            <div className="modal-body">
                                              <div className="row">
                                                <div className="col-md-12">
                                                  <label className="form-label">
                                                    Enter Allergy
                                                  </label>
                                                  <input
                                                    type="text"
                                                    name="name"
                                                    placeholder="Allergy"
                                                    value={formData13.name}
                                                    onChange={
                                                      handleAllergyNameChange
                                                    }
                                                    className="form-control"
                                                  />
                                                  {filteredAllergyNames.length >
                                                    0 && (
                                                      <ul
                                                        className="list-group position-absolute w-100"
                                                        style={{ zIndex: 10 }}
                                                      >
                                                        {filteredAllergyNames.map(
                                                          (item, index) => (
                                                            <li
                                                              key={index}
                                                              className="list-group-item list-group-item-action"
                                                              onClick={() =>
                                                                handleSelectAllergyName(
                                                                  item.name
                                                                )
                                                              }
                                                            >
                                                              {item.name}
                                                            </li>
                                                          )
                                                        )}
                                                      </ul>
                                                    )}
                                                </div>
                                                <div className="col-md-12">
                                                  <label className="form-label">
                                                    Enter Description
                                                  </label>
                                                  <input
                                                    type="text"
                                                    name="description"
                                                    placeholder="Description"
                                                    value={
                                                      formData13.description
                                                    }
                                                    onChange={
                                                      handleDescriptionChange
                                                    }
                                                    className="form-control"
                                                  />
                                                  {filteredDescriptions.length >
                                                    0 && (
                                                      <ul
                                                        className="list-group position-absolute w-100"
                                                        style={{ zIndex: 10 }}
                                                      >
                                                        {filteredDescriptions.map(
                                                          (item, index) => (
                                                            <li
                                                              key={index}
                                                              className="list-group-item list-group-item-action"
                                                              onClick={() =>
                                                                handleSelectDescription(
                                                                  item.description
                                                                )
                                                              }
                                                            >
                                                              {item.description}
                                                            </li>
                                                          )
                                                        )}
                                                      </ul>
                                                    )}
                                                </div>
                                              </div>
                                            </div>
                                            <div className="modal-footer justify-content-end">
                                              <button
                                                type="button"
                                                className="cancelText"
                                                onClick={closeAllergy}
                                              >
                                                Cancel
                                              </button>
                                              {isEditing9 ? (
                                                <button
                                                  type="button"
                                                  className="bgBtn"
                                                  onClick={() => {
                                                    updateAllergy(formData13);
                                                  }}
                                                >
                                                  Update Allergy
                                                </button>
                                              ) : (
                                                <button
                                                  type="button"
                                                  className="bgBtn"
                                                  onClick={addxray}
                                                >
                                                  Add Allergy
                                                </button>
                                              )}
                                            </div>
                                          </div>
                                        </div>
                                      </div>
                                    )}
                                    <div className="d-flex justify-content-between">
                                      <h5>Allergies</h5>

                                      <div
                                        className="addBtnIcon"
                                        onClick={openAllergy}
                                        style={{ cursor: "pointer" }}
                                      >
                                        <i class="borderBtn ti ti-plus f-20"></i>
                                      </div>
                                    </div>
                                  </div>
                                  <div className="card-body p-0 bg-white rounded-bottom-4">
                                    <div className="table-responsive">
                                      <table className="table">
                                        <thead>
                                          <tr>
                                            <th>SR</th>
                                            <th>Allergy</th>
                                            <th>Description</th>
                                            <th>Action</th>
                                          </tr>
                                        </thead>
                                        <tbody>
                                          {dataAllergy &&
                                            dataAllergy.length > 0 ? (
                                            dataAllergy.map((plan, index) => (
                                              <tr key={index}>
                                                <td>{index + 1}</td>
                                                <td>
                                                  {plan?.allergy_name || "N/A"}
                                                </td>
                                                <td>
                                                  {plan?.allergy_type || "N/A"}
                                                </td>
                                                <td className="text-center d-flex gap-2">
                                                  <button
                                                    type="button"
                                                    className="avtar avtar-xs btn-link-secondary viewIcon"
                                                    onClick={() =>
                                                      handleEditAllergy(plan)
                                                    }
