                                                  value: "provisional",
                                                  label: "Provisional",
                                                },
                                                {
                                                  value: "confirmed",
                                                  label: "Confirmed",
                                                },
                                              ]}
                                              value={
                                                diagnosisStatus
                                                  ? {
                                                    value: diagnosisStatus,
                                                    label:
                                                      diagnosisStatus ===
                                                        "provisional"
                                                        ? "Provisional"
                                                        : "Confirmed",
                                                  }
                                                  : null
                                              }
                                              onChange={(option) =>
                                                setDiagnosisStatus(
                                                  option ? option.value : ""
                                                )
                                              }
                                              placeholder="Select status..."
                                            />
                                          </div>
                                        </div>
                                        {show ? (
