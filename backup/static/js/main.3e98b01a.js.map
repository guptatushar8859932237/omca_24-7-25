                                            : ""
                                        }
                                      />
                                    </div> */}
                                    <div className="col-lg-6">
                                      <label className="form-label">
                                        Appointment Date
                                      </label>
                                      <input
                                        type="date"
                                        name="appointmentDate"
                                        className="form-control"
                                        onChange={handleChange23}
                                        value={
                                          appointmentdata?.appointmentDate
                                            ? new Date(
                                              appointmentdata?.appointmentDate
                                            )
                                              .toISOString()
                                              .split("T")[0]
                                            : ""
                                        }
                                      />
                                    </div>
                                    <div className="col-lg-6">
                                      <label className="form-label">
                                        Appointment Type
                                      </label>
                                      <div className="d-flex align-items-center gap-3 mb-3">
                                        <label
                                          className="form-check-label d-flex align-items-center gap-2"
                                          style={{ cursor: "pointer" }}
                                        >
                                          <input
                                            type="checkbox"
                                            name="status"
                                            value="Waiting"
                                            onChange={handleChange23}
                                            style={{ cursor: "pointer" }}
                                            checked={appointmentdata.status?.includes(
                                              "Waiting"
                                            )}
                                          />
                                          Waiting
                                        </label>
                                        <label
                                          className="form-check-label d-flex align-items-center gap-2"
                                          style={{ cursor: "pointer" }}
                                        >
                                          <input
                                            type="checkbox"
                                            name="status"
                                            value="Emergency"
                                            onChange={handleChange23}
                                            style={{ cursor: "pointer" }}
                                            checked={appointmentdata.status?.includes(
                                              "Emergency"
                                            )}
                                          />
                                          Emergency
                                        </label>
                                      </div>
                                    </div>

                                    <div className="col-md-6">
                                      <label className="form-label">
                                        Start Time
                                      </label>
                                      <input
                                        type="time"
                                        className={`form-control ${errors.startTime ? "is-invalid" : ""
                                          }`}
                                        name="startTime"
                                        value={appointmentdata.startTime}
                                        onChange={handleChange23}
                                      />
                                    </div>
                                    <div className="col-md-12">
                                      <label className="form-label">
                                        End Time
                                      </label>
                                      <input
                                        type="time"
                                        className={`form-control ${errors.endTime ? "is-invalid" : ""
                                          }`}
                                        name="endTime"
                                        value={appointmentdata.endTime}
                                        onChange={handleChange23}
                                      />
                                    </div>
                                    <div className="col-lg-12">
                                      <label className="form-label">
                                        Notes
                                      </label>
                                      <input
                                        type="text"
                                        placeholder="Notes"
                                        className={`form-control ${errors.reason ? "is-invalid" : ""
                                          }`}
                                        name="reason"
                                        value={appointmentdata.reason}
                                        onChange={handleChange23}
                                      />
                                    </div>
                                  </div>
                                </div>
                                <div className="d-flex modal-footer justify-content-end">
                                  <button
                                    type="button"
                                    className="cancelText"
                                    onClick={handleclose111}
                                  >
                                    Cancel
                                  </button>
                                  <button
                                    className="bgBtn"
                                    onClick={() => {
                                      handleclickddappointment();
                                    }}
                                  >
                                    Edit Appointment
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        )}
                        <button
                          className="bgBtn"
                          onClick={handleclickpopusopenn}
                        >
                          New Appointment
                        </button>
                      </div>
                    </div>
                    <div className="card-body">
                      <div className="table-responsive mt-0">
                        <table className="table" id="pc-dt-simple">
                          <thead>
                            <tr>
                              <th>Sr No.</th>
                              <th>Appointment Date</th>
                              <th>Doctor Name</th>
                              <th>Start Time</th>
                              <th>End Time</th>
                              <th>Reason</th>
                              <th>Appointment Status</th>
                              <th className="text-center">Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            {currentPatients && currentPatients.length > 0 ? (
                              currentPatients.map((item, index) => {
                                return (
                                  <tr key={index}>
                                    <td>
                                      {(currentPage - 1) * 10 + index + 1}
                                    </td>
                                    <td>
                                      {new Date(
                                        item?.appointmentDate
                                      ).toLocaleDateString("en-GB")}
                                    </td>
                                    <td>{item?.displayName}</td>
                                    <td>
                                      {item?.startTime
                                        ? new Date(
                                          `1970-01-01T${item?.startTime}`
                                        ).toLocaleTimeString("en-US", {
                                          hour: "2-digit",
                                          minute: "2-digit",
                                          hour12: true,
                                        })
                                        : ""}
                                    </td>
                                    <td>
                                      {item?.endTime
                                        ? new Date(
                                          `1970-01-01T${item?.endTime}`
                                        ).toLocaleTimeString("en-US", {
                                          hour: "2-digit",
                                          minute: "2-digit",
                                          hour12: true,
                                        })
                                        : ""}
                                    </td>
                                    {/* <td>
                                      {new Date(
                                        `1970-01-01T${item.endTime}`
                                      ).toLocaleTimeString("en-US", {
                                        hour: "2-digit",
                                        minute: "2-digit",
                                        hour12: true,
                                      })}
                                    </td> */}
                                    <td>{item.reason}</td>
                                    <td>{item.status}</td>
                                    <td className="text-center">
                                      <div
                                        style={{ cursor: "pointer" }}
                                        onClick={() => {
                                          handleclicknavi(item);
                                        }}
                                        className=" viewIcon avtar avtar-xs btn-link-secondary"
                                      >
                                        <i className="ti ti-eye f-20" />
                                        <span>View</span>
                                      </div>
                                      <div
                                        style={{ cursor: "pointer" }}
                                        onClick={() => {
                                          handlimodalopen(item);
                                        }}
                                        className="avtar avtar-xs btn-link-secondary editIcon"
                                      >
                                        <i className="ti ti-edit f-20" />
                                        <span>Edit</span>
                                      </div>
                                      <div
                                        style={{ cursor: "pointer" }}
                                        className="avtar avtar-xs btn-link-secondary deleteIcon"
                                        onClick={() => {
                                          handleclikdeleteapp(item);
                                        }}
                                      >
                                        <i className="ti ti-trash f-20" />
                                        <span>Delete</span>
                                      </div>
                                    </td>
                                  </tr>
                                );
                              })
                            ) : (
                              <tr>
                                <td
                                  colSpan="12"
                                  className="text-center text-muted"
                                >
                                  No Appointment found
                                </td>
                              </tr>
                            )}
                          </tbody>
                        </table>

                        {totalPages > 1 && (
                          <nav className="tablepagination">
                            <ul className="pagination justify-content-end mb-2 me-3">
                              <li
                                className={`page-item ${currentPage === 1 ? "disabled" : ""
                                  }`}
                              >
                                <button
                                  className="page-link"
                                  onClick={() =>
                                    currentPage > 1 &&
                                    setCurrentPage(currentPage - 1)
                                  }
                                >
                                  &laquo;
                                </button>
                              </li>
                              <li className="pageNmbr">{`${currentPage} of ${totalPages}`}</li>
                              <li
                                className={`page-item ${currentPage === totalPages ? "disabled" : ""
                                  }`}
                              >
                                <button
                                  className="page-link"
                                  onClick={() =>
                                    currentPage < totalPages &&
                                    setCurrentPage(currentPage + 1)
                                  }
                                >
                                  &raquo;
                                </button>
                              </li>
                            </ul>
                          </nav>
                        )}
                        {addpatinemodal && (
                          <div
                            className="modal fade show"
                            style={{
                              backgroundColor: "rgba(56, 53, 53, 0.5)",
                              display: "block",
                            }}
                          >
                            <div className="modal-dialog modal-lg">
                              <div className="modal-content">
                                <div className="modal-header">
                                  <h5 className="modal-title">
                                    Add Appointment
                                  </h5>
                                </div>
                                <div className="modal-body">
                                  <div className="row py-2">
                                    {formData1.status === "Waiting" ? (
                                      ""
                                    ) : (
                                      <div className="col-lg-6">
                                        <label className="form-label">
                                          Doctor
                                        </label>
                                        <select
                                          className={`form-select ${errors.doctorId ? "is-invalid" : ""
                                            }`}
                                          name="doctorId"
                                          value={formData1.doctorId}
                                          onChange={handleChange1}
                                        >
                                          <option value="">
                                            Select Doctor
                                          </option>
                                          {doctors1.map((doctor) => (
                                            <option
                                              key={doctor.id}
                                              value={doctor.id}
                                            >
                                              {doctor.displayName}
                                            </option>
                                          ))}
                                        </select>
                                        <div className="invalid-feedback">
                                          {errors.doctorId}
                                        </div>
                                      </div>
                                    )}
                                    {/* <div className="col-lg-6">
                                      <label className="form-label">
                                        Appointment Date
                                      </label>
                                      <input
                                        type="date"
                                        className={`form-control ${
                                          errors.appointmentDate
                                            ? "is-invalid"
                                            : ""
                                        }`}
                                        name="appointmentDate"
                                        value={formData1.appointmentDate}
                                        onChange={handleChange1}
                                      />
                                      <div className="invalid-feedback">
                                        {errors.appointmentDate}
                                      </div>
                                    </div> */}
                                    <div className="col-lg-6">
                                      <label className="form-label">
                                        Appointment Date
                                      </label>
                                      <input
                                        type="date"
                                        className={`form-control ${errors?.appointmentDate
                                          ? "is-invalid"
                                          : ""
                                          }`}
                                        name="appointmentDate"
                                        value={formData1?.appointmentDate}
                                        onChange={handleChange1}
                                        min={
                                          new Date().toISOString().split("T")[0]
                                        } // ✅ Prevent past dates
                                      />
                                      <div className="invalid-feedback">
                                        {errors?.appointmentDate}
                                      </div>
                                    </div>
                                    <div className="col-lg-6">
                                      <label className="form-label">
                                        Appointment Type
                                      </label>
                                      <div className="d-flex align-items-center gap-3 mb-3">
                                        <label
                                          className="form-check-label d-flex align-items-center gap-2"
                                          style={{ cursor: "pointer" }}
                                        >
                                          <input
                                            type="checkbox"
                                            name="status"
                                            value="Waiting"
                                            style={{ cursor: "pointer" }}
                                            onChange={(e) =>
                                              handleChange1({
                                                target: {
                                                  name: "status",
                                                  value:
                                                    formData1.status ===
                                                      "Waiting"
                                                      ? ""
                                                      : e.target.value,
                                                },
                                              })
                                            }
                                            checked={
                                              formData1.status === "Waiting"
                                            }
                                          />
                                          Waiting
                                        </label>

                                        <label
                                          className="form-check-label d-flex align-items-center gap-2"
                                          style={{ cursor: "pointer" }}
                                        >
                                          <input
                                            type="checkbox"
                                            name="status"
                                            value="Emergency"
                                            style={{ cursor: "pointer" }}
                                            onChange={(e) =>
                                              handleChange1({
                                                target: {
                                                  name: "status",
                                                  value:
                                                    formData1.status ===
                                                      "Emergency"
                                                      ? ""
                                                      : e.target.value,
                                                },
                                              })
                                            }
                                            checked={
                                              formData1.status === "Emergency"
                                            }
                                          />
                                          Emergency
                                        </label>
                                      </div>
                                    </div>

                                    {formData1.status === "Waiting" ? (
                                      ""
                                    ) : (
                                      <>
                                        <div className="col-md-6">
                                          <label className="form-label">
                                            Start Time
                                          </label>
                                          <input
                                            type="time"
                                            className={`form-control ${errors.startTime
                                              ? "is-invalid"
                                              : ""
                                              }`}
                                            name="startTime"
                                            value={formData1.startTime}
                                            onChange={handleChange1}
                                          />
                                          <div className="invalid-feedback">
                                            {errors.startTime}
                                          </div>
                                        </div>
                                        <div className="col-md-12">
                                          <label className="form-label">
                                            End Time
                                          </label>
                                          <input
                                            type="time"
                                            className={`form-control ${errors.endTime ? "is-invalid" : ""
                                              }`}
                                            name="endTime"
                                            value={formData1.endTime}
                                            onChange={handleChange1}
                                          />
                                          <div className="invalid-feedback">
                                            {errors.endTime}
                                          </div>
                                        </div>
                                      </>
                                    )}
                                    <div className="col-lg-12">
                                      <label className="form-label">
                                        Notes
                                      </label>
                                      <input
                                        type="text"
                                        className={`form-control ${errors.reason ? "is-invalid" : ""
                                          }`}
                                        name="reason"
                                        value={formData1.reason}
                                        onChange={handleChange1}
                                        placeholder="Notes"
                                      />
                                      <div className="invalid-feedback">
                                        {errors.reason}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                                <div className="modal-footer justify-content-end">
                                  <button
                                    type="button"
                                    className="cancelText"
                                    onClick={handleclickpopusopenn11}
                                  >
                                    Cancel Appointment
                                  </button>
                                  <button
                                    className="bgBtn"
                                    onClick={handleSubmit}
                                  >
                                    Add Appointment
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                className="tab-pane fade"
                id="labs"
                role="labs"
                aria-labelledby="lab-tab"
              >
                <div className="col-12">
                  <div className="row">
                    <div className="col-12 searchParent"></div>
                    <div className="col-md-12">
                      <div className="card table-card patientCardHeader">
                        <div className="tableHeader">
                          <div className="d-sm-flex align-items-center justify-content-between">
                            <div className="tableSearch">
                              <input
                                type="text"
                                placeholder="Search by name, or mobile"
                                className="form-control"
                                value={labSearch}
                                onChange={(e) => setLabSearch(e.target.value)}
                              />
                              <span className="searchIcon">
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  width="18"
                                  height="18"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke="gray"
                                  style={{
                                    position: "absolute",
                                    top: "50%",
                                    left: "10px",
                                    transform: "translateY(-50%)",
                                    pointerEvents: "none",
                                  }}
                                >
                                  <path
                                    strokeLinecap="round"
                                    strokeLinejoin="round"
                                    strokeWidth={2}
                                    d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"
                                  />
                                </svg>
                              </span>
                            </div>
                            <div className="tableHeaderBtn">
                              <button
                                className="bgBtn"
                                onClick={handleclickopentestadd}
                              >
                                <i className="fas fa-plus me-2"></i>
                                Add Test
                              </button>
                            </div>
                          </div>
                        </div>
                        <div className="pb-0">
                          <div className="table-responsive">
                            <table className="table">
                              <thead>
                                <tr>
                                  <th>Patient </th>
                                  <th>Lab Name</th>
                                  <th>Services</th>
                                  <th>Title</th>
                                  <th>Description</th>
                                  <th>Doctor Name</th>
                                  <th>Status</th>
                                  <th className="text-center">Action</th>
                                </tr>
                              </thead>
                              <tbody>
                                {filteredLabs.length > 0 ? (
                                  filteredLabs.map((item, index) => {
                                    return (
                                      <>
                                        <tr key={index}>
                                          <td>{item.patient_name}</td>
                                          <td>{item.lab_name}</td>
                                          <td>
                                            {item.services &&
                                              item.services.length > 0 ? (
                                              <div className="d-flex flex-wrap gap-1">
                                                {item.services
                                                  .slice(0, 2)
                                                  .map((service, i) => (
                                                    <span
                                                      key={i}
                                                      className="badge bg-light text-dark border"
                                                    >
                                                      {service.serviceName}
                                                    </span>
                                                  ))}
                                                {item.services.length > 2 && (
                                                  <span
                                                    className="badge bg-primary"
                                                    style={{
                                                      cursor: "pointer",
                                                    }}
                                                    onClick={() =>
                                                      handleSeeMoreServices(
                                                        item.services
                                                      )
                                                    }
                                                  >
                                                    +{item.services.length - 2}{" "}
                                                    More
                                                  </span>
                                                )}
                                              </div>
                                            ) : (
                                              "-"
                                            )}
                                          </td>
                                          <td>{item.title}</td>
                                          <td>{item.description}</td>
                                          <td>{item.doctor_name}</td>
                                          <td>
                                            {item.status ||
                                              item.report_status ||
                                              "-"}
                                          </td>
                                          <td>
                                            <div className="d-flex gap-2 justify-content-center">
                                              <div
                                                onClick={() =>
                                                  handleLabView(item)
                                                }
                                                style={{ cursor: "pointer" }}
                                                className="avtar avtar-xs btn-link-secondary viewIcon"
                                              >
                                                <i className="ti ti-eye f-20" />
                                                <span>View</span>
                                              </div>
                                              <div
                                                onClick={() =>
                                                  handleLabEdit(item)
                                                }
                                                style={{ cursor: "pointer" }}
                                                className="avtar avtar-xs btn-link-secondary editIcon"
                                              >
                                                <i className="ti ti-edit f-20" />
                                                <span>Edit</span>
                                              </div>
                                              <div
                                                style={{ cursor: "pointer" }}
                                                className="avtar avtar-xs btn-link-secondary deleteIcon"
                                                onClick={() =>
                                                  handleLabDelete(item)
                                                }
                                              >
                                                <i className="ti ti-trash f-20" />
                                                <span>Delete</span>
                                              </div>
                                            </div>
                                          </td>
                                        </tr>
                                      </>
                                    );
                                  })
                                ) : (
                                  <tr>
                                    <td colSpan="10" className="text-center">
                                      No request found.
                                    </td>
                                  </tr>
                                )}
                              </tbody>
                            </table>
                          </div>
                        </div>
                        {openmodaltest && (
                          <div
                            className="modal fade show"
                            style={{
                              backgroundColor: "rgba(81, 81, 81, 0.5)",
                              display: "block",
                            }}
                          >
                            <div className="modal-dialog modal-lg">
                              <div className="modal-content">
                                <div className="modal-header">
                                  <h5 className="modal-title">Add Test</h5>
                                </div>
                                <div className="modal-body">
                                  <div className="row">
                                    <div className="col-md-6">
                                      <label className="form-label">
                                        Title
                                      </label>
                                      <input
                                        type="text"
                                        name="title"
                                        onChange={handlechange}
                                        placeholder="Title"
                                        className="form-control"
                                      />
                                    </div>
                                    <div className="col-md-6">
                                      <label className="form-label">
                                        Description
                                      </label>
                                      <textarea
                                        type="text"
                                        name="description"
                                        placeholder="Description"
                                        onChange={handlechange}
                                        className="form-control"
                                      />
                                    </div>
                                  </div>
                                  <div className="row">
                                    <div className="col-md-6">
                                      <label className="form-label">
                                        Select Lab
                                      </label>
                                      <select
                                        className="form-select"
                                        name="category"
                                        onChange={handlechange}
                                      >
                                        <option>Select</option>
                                        {data2 &&
                                          data2 &&
                                          data2.map((item, index) => {
                                            // console.log(item);
                                            return (
                                              <>
                                                <option
                                                  key={index}
                                                  value={item.id}
                                                >
                                                  {item.lab_name}
                                                </option>
                                              </>
                                            );
                                          })}
                                      </select>
                                    </div>
                                    <div className="col-md-6">
                                      <label className="form-label">
                                        Select Doctor
                                      </label>
                                      <select
                                        name="doctor_id"
                                        onChange={handlechange}
                                        className="form-control"
                                      >
                                        <option>Select</option>
                                        {doctors &&
                                          doctors.length > 0 &&
                                          doctors.map((items, index) => {
                                            // console.log(items);
                                            return (
                                              <option
                                                key={index}
                                                value={items.id}
                                              >
                                                {items.fullName}
                                              </option>
                                            );
                                          })}
                                      </select>
                                    </div>
                                  </div>
                                  <div className="row">
                                    <div className="col-md-12 autoComplete">
                                      <label className="form-label">
                                        Select Services
                                      </label>
                                      <Autocomplete
                                        multiple
                                        id="services-selection"
                                        options={labServices || []}
                                        getOptionLabel={(option) => {
                                          const serviceName =
                                            option.serviceName ||
                                            option.service ||
                                            option.name ||
                                            "Unknown Service";
                                          const category =
                                            option.category || "";
                                          const price = option.price
                                            ? `${option.price} BHD`
                                            : "";
                                          let label = serviceName;
                                          if (category)
                                            label += ` (${category})`;
                                          if (price) label += ` - ${price}`;
                                          return label;
                                        }}
                                        value={(inpval.serviceIds || [])
                                          .map((id) =>
                                            labServices.find(
                                              (service) => service.id === id
                                            )
                                          )
                                          .filter(Boolean)}
                                        onChange={(e, newValue) => {
                                          const hasSelectAll = newValue.some(
                                            (option) =>
                                              option && option.isSelectAll
                                          );

                                          if (hasSelectAll) {
                                            const isAllSelected =
                                              inpval.serviceIds &&
                                              labServices.length > 0 &&
                                              inpval.serviceIds.length ===
                                              labServices.length;

                                            const nextIds = isAllSelected
                                              ? []
                                              : labServices.map(
                                                (service) => service.id
                                              );

                                            setInpval((prev) => ({
                                              ...prev,
                                              serviceIds: nextIds,
                                            }));
                                          } else {
                                            const filtered = newValue.filter(
                                              (option) => !option.isSelectAll
                                            );
                                            setInpval((prev) => ({
                                              ...prev,
                                              serviceIds: filtered.map(
                                                (service) => service.id
                                              ),
                                            }));
                                          }
                                        }}
                                        renderInput={(params) => (
                                          <TextField
                                            {...params}
                                            placeholder="Search services..."
                                          />
                                        )}
                                        filterOptions={(
                                          options,
                                          { inputValue }
                                        ) => {
                                          const searchLower =
                                            inputValue.toLowerCase();
                                          const filtered = options.filter(
                                            (option) => {
                                              const serviceName =
                                                option.serviceName ||
                                                option.service ||
                                                option.name ||
                                                "";
                                              const category =
                                                option.category || "";
                                              return (
                                                serviceName
                                                  .toLowerCase()
                                                  .includes(searchLower) ||
                                                category
                                                  .toLowerCase()
                                                  .includes(searchLower)
                                              );
                                            }
                                          );

                                          if (!inputValue) {
                                            return [
                                              {
                                                id: "__all__",
                                                serviceName:
                                                  "Select All Services",
                                                isSelectAll: true,
                                              },
                                              ...filtered,
                                            ];
                                          }

                                          return filtered;
                                        }}
                                        noOptionsText="No services found"
                                        loadingText="Loading services..."
                                        disabled={
                                          labServices.length === 0 ||
                                          !inpval.category
                                        }
                                        renderOption={(props, option) => {
                                          if (option.isSelectAll) {
                                            return (
                                              <li {...props}>
                                                <strong>
                                                  Select / Deselect All
                                                </strong>
                                              </li>
                                            );
                                          }

                                          const serviceName =
                                            option.serviceName ||
                                            option.service ||
                                            option.name ||
                                            "Unknown Service";
                                          const category =
                                            option.category || "";
                                          const price = option.price || 0;
                                          return (
                                            <li {...props}>
                                              <div>
                                                <strong>{serviceName}</strong>
                                                {category && (
                                                  <small className="text-muted d-block">
                                                    Category: {category}
                                                  </small>
                                                )}
                                                {price > 0 && (
                                                  <small className="text-success d-block">
                                                    Price: {price} BHD
                                                  </small>
                                                )}
                                              </div>
                                            </li>
                                          );
                                        }}
                                        renderTags={(value, getTagProps) =>
                                          value.map((option, index) => (
                                            <Chip
                                              key={option.id}
                                              label={(() => {
                                                const serviceName =
                                                  option.serviceName ||
                                                  option.service ||
                                                  option.name ||
                                                  "Unknown Service";
                                                const category =
                                                  option.category || "";
                                                const price = option.price
                                                  ? `${option.price} BHD`
                                                  : "";
                                                let label = serviceName;
                                                if (category)
                                                  label += ` (${category})`;
                                                if (price)
                                                  label += ` - ${price}`;
                                                return label;
                                              })()}
                                              {...getTagProps({ index })}
                                              color="primary"
                                              variant="outlined"
                                            />
                                          ))
                                        }
                                      />
                                    </div>
                                  </div>
                                  <div className="row">
                                    <div className="col-md-12">
                                      <label className="form-label">
                                        Attachment
                                      </label>
                                      <input
                                        type="file"
                                        name="file"
                                        onChange={handlechange}
                                        className="form-control"
                                        accept="image/*,application/pdf,.doc,.docx"
                                      />
                                      {inpval.file && (
                                        <small className="text-muted">
                                          Selected file: {inpval.file.name}
                                        </small>
                                      )}
                                    </div>
                                  </div>
                                </div>
                                <div className="modal-footer justify-content-end">
                                  <button
                                    type="button"
                                    className="cancelText"
                                    onClick={closeModaladdtest}
                                  >
                                    Cancel
                                  </button>
                                  <button
                                    type="button"
                                    className="bgBtn"
                                    onClick={handletest}
                                  >
                                    Add test
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        )}
                        {serviceListModal && (
                          <div
                            className="modal fade show"
                            style={{
                              backgroundColor: "rgba(0,0,0,0.5)",
                              display: "block",
                              zIndex: 1055,
                            }}
                          >
                            <div className="modal-dialog modal-md">
                              <div className="modal-content">
                                <div className="modal-header">
                                  <h5 className="modal-title">Lab Services</h5>
                                  <button
                                    type="button"
                                    className="btn-close"
                                    onClick={() => setServiceListModal(false)}
                                  ></button>
                                </div>
                                <div className="modal-body">
                                  <ul className="list-group">
                                    {selectedServicesForModal.map(
                                      (service, index) => (
                                        <li
                                          key={index}
                                          className="list-group-item d-flex justify-content-between align-items-center"
                                        >
                                          {service.serviceName}
                                          {service.category && (
                                            <span className="badge bg-secondary rounded-pill">
                                              {service.category}
                                            </span>
                                          )}
                                        </li>
                                      )
                                    )}
                                  </ul>
                                </div>
                                <div className="modal-footer">
                                  <button
                                    type="button"
                                    className="btn btn-secondary"
                                    onClick={() => setServiceListModal(false)}
                                  >
                                    Close
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                className="tab-pane fade"
                id="vitalsings"
                role="tabpanel"
                aria-labelledby="vitalsings-tab"
              >
                <div className="col-12">
                  <div className="table-card patientCardHeader">
                    <div className=" borderShapeTab tableHeader">
                      <div className="d-sm-flex align-items-center justify-content-end ">
                        <div>
                          <button
                            className="bgBtn"
                            onClick={handleclickopenvital}
                          >
                            Add Vitals
                          </button>
                        </div>
                      </div>
                    </div>
                    <div className="card-body">
                      <div className="table-responsive mt-0 mb-0">
                        <table className="table" id="pc-dt-simple">
                          <thead>
                            <tr>
                              <th>Date</th>
                              <th>Time</th>
                              <th>Blood Pressure</th>
                              <th>Respiratory Rate</th>
                              <th>spo2</th>
                              <th>Temp </th>
                              <th>Weight</th>
                              <th>Height </th>
                              <th>Urgency </th>
                              <th>Risk of Fall </th>
                              <th className="text-center">Action </th>
                            </tr>
                          </thead>

                          <tbody>
                            {patinetvitals &&
                              patinetvitals.length > 0 &&
                              patinetvitals.map((item, index) => {
                                // Split BP values
                                const systolic = item.blood_pressure_systolic;
                                const diastolic = item.blood_pressure_diastolic;

                                // Determine BP color (Normal = 90–120 / 60–80)
                                const bpNormal =
                                  systolic >= 90 &&
                                  systolic <= 120 &&
                                  diastolic >= 60 &&
                                  diastolic <= 80;
                                const bpColor = bpNormal
                                  ? "text-success"
                                  : "text-danger";

                                // SPO2 color (Normal = 95–100)
                                const spo2Color =
                                  item.spo2 >= 95 && item.spo2 <= 100
                                    ? "text-success"
                                    : "text-danger";

                                // Respiratory Rate color (Normal = 12–20)
                                const respColor =
                                  item.respiratory_rate >= 12 &&
                                    item.respiratory_rate <= 20
                                    ? "text-success"
                                    : "text-danger";

                                // Temperature color (Normal = 36.1–37.2°C)
                                const tempColor =
                                  item.temperature >= 36.1 &&
                                    item.temperature <= 37.2
                                    ? "text-success"
                                    : "text-danger";

                                // Weight (normal just for display)
                                const weightColor = "text-dark";

                                // Height (neutral color)
                                const heightColor = "text-dark";

                                return (
                                  <tr key={index}>
                                    <td>
                                      {new Date(
                                        item?.recorded_at
                                      ).toLocaleDateString("en-GB")}
                                    </td>
                                    <td>
                                      {new Date(
                                        item?.recorded_at
                                      ).toLocaleTimeString([], {
                                        hour: "2-digit",
                                        minute: "2-digit",
                                        second: "2-digit",
                                      })}
                                    </td>

                                    {/* Blood Pressure */}
                                    <td className={bpColor}>
                                      {diastolic}/{systolic} mmHg
                                    </td>

                                    {/* Respiratory Rate */}
                                    <td className={respColor}>
                                      {item.respiratory_rate} bpm
                                    </td>

                                    {/* SPO2 */}
                                    <td className={spo2Color}>{item.spo2} %</td>

                                    {/* Temperature */}
                                    <td className={tempColor}>
                                      {item.temperature} °C
                                    </td>

                                    {/* Weight */}
                                    <td className={weightColor}>
                                      {item.weight} KG
                                    </td>

                                    {/* Height */}
                                    <td className={heightColor}>
                                      {item.height} cm
                                    </td>

                                    {/* Urgency */}
                                    {item.urgency === "High" ? (
                                      <td className="text-danger">
                                        {item.urgency}
                                      </td>
                                    ) : item.urgency === "Normal" ? (
                                      <td className="text-success">
                                        {item.urgency}
                                      </td>
                                    ) : (
                                      <td className="text-warning">
                                        {item.urgency}
                                      </td>
                                    )}

                                    {/* Risk of Fall */}
                                    {item.risk_of_fall === "High" ? (
                                      <td className="text-danger">
                                        {item.risk_of_fall}
                                      </td>
                                    ) : item.risk_of_fall === "Low" ? (
                                      <td className="text-success">
                                        {item.risk_of_fall}
                                      </td>
                                    ) : (
                                      <td className="text-warning">
                                        {item.risk_of_fall}
                                      </td>
                                    )}

                                    {/* Action Buttons */}
                                    <td className="text-center">
                                      <div
                                        style={{ cursor: "pointer" }}
                                        onClick={() => handleclickpen(item)}
                                        className="avtar avtar-xs btn-link-secondary editIcon"
                                      >
                                        <i className="ti ti-edit f-20" />{" "}
                                        <span>Edit</span>
                                      </div>

                                      <div
                                        style={{ cursor: "pointer" }}
                                        onClick={() => handleclickpen123(item)}
                                        className="avtar avtar-xs btn-link-secondary editIcon"
                                      >
                                        <i className="ti ti-eye f-20" />{" "}
                                        <span>View</span>
                                      </div>

                                      <div
                                        style={{ cursor: "pointer" }}
                                        onClick={() =>
                                          handleclickdeletevital(item.id)
                                        }
                                        className="avtar avtar-xs btn-link-secondary deleteIcon"
                                      >
                                        <i className="ti ti-trash f-20" />{" "}
                                        <span>Delete</span>
                                      </div>
                                    </td>
                                  </tr>
                                );
                              })}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
                {openmodalforvital && (
                  <div
                    className="modal fade show"
                    style={{
                      backgroundColor: "rgba(0,0,0,0.5)",
                      display: "block",
                    }}
                  >
                    <div className="modal-dialog modal-xl">
                      <div className="modal-content">
                        <div className="modal-header">
                          <h5 className="modal-title">Edit Vital</h5>
                        </div>
                        <div
                          className="row p20"
                          style={{ paddingLeft: "25px", paddingRight: "25px" }}
                        >
                          <div className="d-flex">
                            <div className="col-lg-6 col-md-6">
                              <p>
                                {" "}
                                <strong> Name:</strong>{" "}
                                {location?.state?.patientid?.firstName +
                                  " " +
                                  location?.state?.patientid?.lastName}
                              </p>
                              <p>
                                <strong>Nurse:</strong> {userddertails?.role}
                              </p>
                              <p>
                                <strong>Doctor:</strong>{" "}
                                {location?.state?.patientid?.Primary_Doctor}
                              </p>
                            </div>
                            <div className="col-lg-6 col-md-6">
                              <p>
                                <strong> Age:</strong>{" "}
                                {location?.state?.patientid?.age}
                              </p>

                              <p>
                                <strong>Date:</strong> {date ? date : ""}
                              </p>

                              <p>
                                <strong>Time:</strong> {time}
                              </p>
                            </div>
                          </div>
                        </div>
                        <hr class="hrLine" />
                        <div className="modal-body">
                          <div className="row">
                            <div className="col-lg-8">
                              <div className="row">
                                <div className="col-md-6">
                                  <label className="form-label">
                                    Blood Pressure Systolic
                                  </label>
                                  <input
                                    type="number"
                                    name="blood_pressure_systolic"
                                    min={40}
                                    max={200}
                                    value={formData?.blood_pressure_systolic}
                                    onChange={handleChange}
                                    className="form-control"
                                  />
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">
                                    Blood Pressure Diastolic
                                  </label>
                                  <input
                                    type="number"
                                    name="blood_pressure_diastolic"
                                    value={formData?.blood_pressure_diastolic}
                                    onChange={handleChange}
                                    min={20}
                                    max={180}
                                    className="form-control"
                                  />
                                </div>
                                <div className="col-12 ">
                                  <label className="form-label">
                                    BP Position
                                  </label>
                                  <br />
                                  {[
                                    "Right Arm",
                                    "Left Arm",
                                    "Right Leg",
                                    "Left Leg",
                                  ].map((pos) => (
                                    <label className="me-3" key={pos}>
                                      <input
                                        type="radio"
                                        name="bp_position"
                                        value={pos}
                                        style={{ cursor: "pointer" }}
                                        checked={formData?.bp_position === pos}
                                        onChange={handleChange}
                                      />{" "}
                                      <span className="form-label">{pos}</span>
                                    </label>
                                  ))}
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">
                                    Respiratory Rate
                                  </label>
                                  <input
                                    type="number"
                                    name="respiratory_rate"
                                    value={formData.respiratory_rate}
                                    onChange={handleChange}
                                    className="form-control"
                                    min="5"
                                    max="50"
                                    step="1"
                                  />
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">
                                    Pulse (BPM)
                                  </label>
                                  <input
                                    type="number"
                                    name="pulse"
                                    value={formData.pulse}
                                    onChange={handleChange}
                                    className="form-control"
                                    min="10"
                                    max="400"
                                    step="1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">
                                    Temperature (°C)
                                  </label>
                                  <input
                                    type="number"
                                    name="temperature"
                                    value={formData.temperature}
                                    onChange={handleChange}
                                    className="form-control"
                                    min="10"
                                    max="60"
                                    step="0.1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">spo2 (%)</label>
                                  <input
                                    type="number"
                                    name="spo2"
                                    value={formData.spo2}
                                    onChange={handleChange}
                                    className="form-control"
                                    min="0"
                                    max="100"
                                    step="1"
                                  />
                                </div>

                                <div className="col-md-6  ">
                                  <label className="form-label">
                                    RBS (mg/dl)
                                  </label>
                                  <input
                                    type="number"
                                    name="rbs_mg"
                                    value={formData.rbs_mg}
                                    onChange={handleChange}
                                    className="form-control"
                                    min="10"
                                    max="800"
                                    step="1"
                                  />
                                </div>

                                <div className="col-md-6  ">
                                  <label className="form-label">
                                    RBS (mmol/l)
                                  </label>
                                  <input
                                    type="number"
                                    name="rbs_nmol"
                                    value={formData.rbs_nmol}
                                    onChange={handleChange}
                                    className="form-control"
                                    min="0.5"
                                    max="50"
                                    step="0.1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">
                                    Weight (kg)
                                  </label>
                                  <input
                                    type="number"
                                    name="weight"
                                    value={formData.weight}
                                    onChange={handleChange}
                                    className="form-control"
                                    min="0"
                                    max="1000"
                                    step="0.1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">
                                    Height (cm)
                                  </label>
                                  <input
                                    type="number"
                                    name="height"
                                    value={formData.height}
                                    onChange={handleChange}
                                    className="form-control"
                                    min="0"
                                    max="300"
                                    step="0.1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">
                                    BMI (auto-calculated)
                                  </label>
                                  <input
                                    type="text"
                                    value={calculateBMI()}
                                    readOnly
                                    className="form-control bg-light"
                                  />
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">
                                    Risk of Fall
                                  </label>
                                  <br />
                                  {["Low", "Medium", "High"].map((option) => {
                                    const getColorClass = () => {
                                      if (formData.risk_of_fall !== option)
                                        return "";
                                      if (option === "High")
                                        return "text-danger";
                                      if (option === "Medium")
                                        return "text-warning";
                                      if (option === "Low")
                                        return "text-success";
                                    };
                                    return (
                                      <label
                                        className={`me-3 form-label ${getColorClass()}`}
                                        key={option}
                                      >
                                        <input
                                          type="radio"
                                          name="risk_of_fall"
                                          value={option}
                                          style={{ cursor: "pointer" }}
                                          checked={
                                            formData.risk_of_fall === option
                                          }
                                          onChange={handleChange}
                                        />{" "}
                                        {option}
                                      </label>
                                    );
                                  })}
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">Urgency</label>
                                  <br />
                                  {["Normal", "Moderate", "High"].map(
                                    (option) => {
                                      const getColorClass = () => {
                                        if (formData.urgency !== option)
                                          return "";
                                        if (option === "High")
                                          return "text-danger";
                                        if (option === "Moderate")
                                          return "text-warning";
                                        if (option === "Normal")
                                          return "text-success";
                                      };
                                      return (
                                        <label
                                          className={`me-3 form-label ${getColorClass()}`}
                                          key={option}
                                        >
                                          <input
                                            type="radio"
                                            name="urgency"
                                            value={option}
                                            style={{ cursor: "pointer" }}
                                            checked={
                                              formData.urgency === option
                                            }
                                            onChange={handleChange}
                                          />{" "}
                                          {option}
                                        </label>
                                      );
                                    }
                                  )}
                                </div>

                                <div className="col-12 ">
                                  <label className="form-label">Notes</label>
                                  <textarea
                                    name="notes"
                                    rows="3"
                                    className="form-control mb-0"
                                    value={formData?.notes}
                                    onChange={handleChange}
                                  />
                                </div>
                              </div>
                            </div>
                            <div className="col-lg-4">
                              <div className="d-flex">
                                <div className="humanBody">
                                  <img src={human} alt="" />
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div className="modal-footer d-flex justify-content-end">
                          <button
                            type="button"
                            className="cancelText"
                            onClick={handlecloseVitaledit}
                          >
                            Cancel
                          </button>
                          <button
                            type="submit"
                            onClick={handdeditvital}
                            className="bgBtn"
                          >
                            Edit Vital
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
                {openmodalforvital1 && (
                  <div
                    className="modal fade show"
                    style={{
                      backgroundColor: "rgba(0,0,0,0.5)",
                      display: "block",
                    }}
                  >
                    <div className="modal-dialog modal-xl">
                      <div className="modal-content">
                        <div className="modal-header">
                          <h5 className="modal-title">View Vital</h5>
                        </div>
                        <div>
                          <div className="row p20">
                            <div className="d-flex">
                              <div className="col-lg-6 col-md-6">
                                <p>
                                  {" "}
                                  <strong> Name:</strong>{" "}
                                  {location?.state?.patientid?.firstName +
                                    " " +
                                    location?.state?.patientid?.lastName}
                                </p>
                                <p>
                                  <strong>Nurse:</strong> {userddertails?.role}
                                </p>
                                <p>
                                  <strong>Doctor:</strong>{" "}
                                  {location?.state?.patientid?.Primary_Doctor}
                                </p>
                              </div>
                              <div className="col-lg-6 col-md-6">
                                <p>
                                  <strong> Age:</strong>{" "}
                                  {location?.state?.patientid?.age}
                                </p>

                                <p>
                                  <strong>Date:</strong> {date ? date : ""}
                                </p>

                                <p>
                                  <strong>Time:</strong> {time}
                                </p>
                              </div>
                            </div>
                          </div>
                          <div className="row">
                            <div className="col-lg-8">
                              <div className="row p20">
                                <div className="col-md-6">
                                  <label className="form-label">
                                    Blood Pressure Systolic
                                  </label>
                                  <input
                                    name="blood_pressure_systolic"
                                    min={40}
                                    max={200}
                                    disabled
                                    value={formData?.blood_pressure_systolic}
                                    className="form-control"
                                  />
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">
                                    Blood Pressure Diastolic
                                  </label>
                                  <input
                                    name="blood_pressure_diastolic"
                                    value={formData?.blood_pressure_diastolic}
                                    min={20}
                                    max={180}
                                    className="form-control"
                                  />
                                </div>
                                <div className="col-12 ">
                                  <label className="form-label">
                                    BP Position
                                  </label>
                                  <br />
                                  {[
                                    "Right Arm",
                                    "Left Arm",
                                    "Right Leg",
                                    "Left Leg",
                                  ].map((pos) => (
                                    <label className="me-3" key={pos}>
                                      <input
                                        type="radio"
                                        name="bp_position"
                                        value={pos}
                                        style={{ cursor: "pointer" }}
                                        checked={formData?.bp_position === pos}
                                        disabled
                                      />{" "}
                                      <span className="form-label">{pos}</span>
                                    </label>
                                  ))}
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">
                                    Respiratory Rate
                                  </label>
                                  <input
                                    name="respiratory_rate"
                                    value={formData.respiratory_rate}
                                    disabled
                                    className="form-control"
                                    min="5"
                                    max="50"
                                    step="1"
                                  />
                                </div>
                                <div className="col-md-6 ">
                                  <label className="form-label">
                                    Pulse (BPM)
                                  </label>
                                  <input
                                    name="pulse"
                                    value={formData.pulse}
                                    disabled
                                    className="form-control"
                                    min="10"
                                    max="400"
                                    step="1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">
                                    Temperature (°C)
                                  </label>
                                  <input
                                    name="temperature"
                                    value={formData.temperature}
                                    disabled
                                    className="form-control"
                                    min="10"
                                    max="60"
                                    step="0.1"
                                  />
                                </div>
                                <div className="col-md-6">
                                  <label className="form-label">spo2 (%)</label>
                                  <input
                                    name="spo2"
                                    value={formData.spo2}
                                    disabled
                                    className="form-control"
                                    min="0"
                                    max="100"
                                    step="1"
                                  />
                                </div>

                                <div className="col-md-6  ">
                                  <label className="form-label">
                                    RBS (mg/dl)
                                  </label>
                                  <input
                                    name="rbs_mg"
                                    value={formData.rbs_mg}
                                    disabled
                                    className="form-control"
                                    min="10"
                                    max="800"
                                    step="1"
                                  />
                                </div>

                                <div className="col-md-6  ">
                                  <label className="form-label">
                                    RBS (mmol/l)
                                  </label>
