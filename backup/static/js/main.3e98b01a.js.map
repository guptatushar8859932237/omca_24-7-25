                                                    <Slider
                                                      aria-label="Pain Assessment"
                                                      name="pain_assessment"
                                                      value={
                                                        dataMedical?.pain_assessment ||
                                                        1
                                                      } // controlled value
                                                      onChange={(e, newValue) =>
                                                        hhandlechangeaddnotes({
                                                          target: {
                                                            name: "pain_assessment",
                                                            value: newValue,
                                                          },
                                                        })
                                                      }
                                                      step={1}
                                                      marks={marks}
                                                      min={1}
                                                      max={10}
                                                      valueLabelDisplay="auto"
                                                      sx={{
                                                        color: "#4680ff", // active part color
                                                        height: 5, // slider track height
                                                        "& .MuiSlider-rail": {
                                                          height: 5, // inactive track height
                                                          borderRadius: 5,
                                                        },
                                                        "& .MuiSlider-track": {
                                                          height: 5, // active track height
                                                          borderRadius: 5,
                                                        },
                                                        "& .MuiSlider-thumb": {
                                                          height: 20, // thumb size
                                                          width: 20,
                                                          backgroundColor:
                                                            "#4680ff",
                                                          border:
                                                            "2px solid white",
                                                        },
                                                      }}
                                                    />
                                                  </Box>
                                                </div>
                                              </div>
