                                                    Cancel
                                                  </button>
                                                  {editModalOpen ? (
                                                    <button
                                                      type="button"
                                                      className="bgBtn"
                                                      onClick={() => {
                                                        saveEditIllness(
                                                          selectedIllness
                                                        );
                                                      }}
                                                    >
                                                      Update Chronic illness
                                                    </button>
                                                  ) : (
                                                    <button
                                                      type="button"
                                                      className="bgBtn"
                                                      onClick={addxray}
                                                    >
                                                      Add Allergy
                                                    </button>
                                                  )}
                                                </div>
                                              </div>
                                            </div>
                                          </div>
                                        )}
                                      </table>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div className="row halfPart g-3 mb-3">
                          <div className="col-lg-6 col-md-12 col-sm-12 col-12">
                            <div className="cardBorder">
