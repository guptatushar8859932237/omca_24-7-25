                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>View</th>
                                        <th>Action</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      {dataVitals123 &&
                                        dataVitals123.length > 0 ? (
