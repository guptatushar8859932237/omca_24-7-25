                                        </p>
                                      )}
                                    </div>
                                    <div className="iconChief">
                                      {isEditingTreatment ? (
                                        <>
                                          <i
                                            className="ti ti-check f-20  text-success"
                                            style={{
                                              cursor: "pointer",
                                            }}
                                            onClick={handletraeatmentplan}
                                          ></i>
                                          <i
                                            className="ti ti-x f-20 text-danger"
                                            style={{ cursor: "pointer" }}
                                            onClick={() => {
                                              setIsEditingTreatment(false);
                                              setIsEditingTreatment(false);
                                            }}
                                          ></i>
                                        </>
                                      ) : (
                                        <>
                                          {dataMedical.chief_complaint ? (
                                            <i
                                              className="ti ti-edit f-20"
                                              style={{
                                                cursor: "pointer",
                                              }}
                                              onClick={() => {
                                                setTreatmentInput(
                                                  dataMedical?.treatment_plan ||
                                                  ""
                                                );
                                                setIsEditingTreatment(true);
                                              }}
                                            ></i>
                                          ) : (
                                            ""
                                          )}
                                        </>
                                      )}
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                          <div className="col-lg-6 col-md-6 col-sm-6 col-12">
                            <div className="cardBorder h-100">
                              <div className="tableHeader">
                                <h5>Advises </h5>
                              </div>
                              <div className="p20 timeScroll">
                                <div className="paraentTimeline">
                                  <div className="mainChief">
                                    <div>
                                      {editAdvise !== null ? (
                                        <textarea
                                          className="form-control"
                                          rows={3}
                                          value={editAdvise}
                                          onChange={(e) =>
                                            setEditAdvise(e.target.value)
                                          }
                                        />
                                      ) : (
                                        <p>
                                          {dataMedical?.advises
                                            ? dataMedical?.advises
                                            : "N/A"}
                                        </p>
                                      )}
                                    </div>
                                    <div className="iconChief">
                                      {editAdvise !== null ? (
                                        <>
                                          <i
                                            className="ti ti-check f-20 text-success"
                                            style={{
                                              cursor: "pointer",
                                            }}
                                            onClick={handleSaveAdvise}
                                          ></i>
                                          <i
                                            className="ti ti-x f-20 text-danger"
                                            style={{ cursor: "pointer" }}
                                            onClick={() => setEditAdvise(null)}
                                          ></i>
                                        </>
                                      ) : (
                                        <>
                                          {dataMedical.chief_complaint ? (
                                            <i
                                              className="ti ti-edit f-20 cursor-pointer"
                                              onClick={() =>
                                                setEditAdvise(
                                                  dataMedical?.advises || ""
                                                )
                                              }
                                            ></i>
                                          ) : (
                                            ""
                                          )}
                                        </>
                                      )}
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                          <div className="col-lg-6 col-md-6 col-sm-12 col-12">
                            <div className="cardBorder h-100">
                              <div className="tableHeader">
                                <h5>Extra Notes </h5>
                              </div>
                              <div className="p20 timeScroll">
                                <div className="paraentTimeline">
                                  <div className="mainChief">
                                    <div>
                                      {isEditing3 ? (
                                        <textarea
                                          className="form-control"
                                          rows="3"
                                          value={note3}
                                          onChange={(e) =>
                                            setNote3(e.target.value)
                                          }
                                        />
                                      ) : (
                                        <p>
                                          {" "}
                                          {dataMedical?.extra_notes
                                            ? dataMedical?.extra_notes
                                            : "N/A"}
                                        </p>
                                      )}
                                    </div>
                                    <div className="iconChief">
                                      {isEditing3 ? (
                                        <>
                                          <i
                                            className="ti ti-check f-20  text-success"
                                            style={{
                                              cursor: "pointer",
                                            }}
                                            onClick={handleextranotes}
                                          ></i>
                                          <i
                                            className="ti ti-x f-20 text-danger"
                                            style={{ cursor: "pointer" }}
                                            onClick={() => {
                                              setNote3(
                                                dataMedical?.extra_notes || ""
                                              );
                                              setIsEditing3(false);
                                            }}
                                          ></i>
                                        </>
                                      ) : (
                                        <>
                                          {dataMedical.chief_complaint ? (
                                            <i
                                              className="ti ti-edit f-20"
                                              style={{
                                                cursor: "pointer",
                                              }}
                                              onClick={() => {
                                                setNote3(
                                                  dataMedical?.extra_notes || ""
                                                );
                                                setIsEditing3(true);
                                              }}
                                            ></i>
                                          ) : (
                                            ""
                                          )}
                                        </>
                                      )}
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div className="row">
                          <div className="col-12 searchParent"></div>
                          <div className="col-md-12">
                            <div className="card table-card patientCardHeader">
                              <div className="tableHeader">
                                <div className="d-sm-flex align-items-center justify-content-between">
                                  <div className="d-flex align-items-center gap-3">
                                    <h5 className="mb-0">Labs</h5>
                                    <div className="tableSearch">
                                      <input
                                        type="text"
                                        placeholder="Search by Labs name..."
                                        className="form-control"
                                        value={labSearch}
                                        onChange={(e) =>
                                          setLabSearch(e.target.value)
                                        }
                                      />
                                      <span className="searchIcon">
                                        <svg
                                          xmlns="http://www.w3.org/2000/svg"
                                          width="18"
                                          height="18"
                                          fill="none"
                                          viewBox="0 0 24 24"
                                          stroke="gray"
                                          style={{
                                            position: "absolute",
                                            top: "50%",
                                            left: "10px",
                                            transform: "translateY(-50%)",
                                            pointerEvents: "none",
                                          }}
                                        >
                                          <path
                                            strokeLinecap="round"
                                            strokeLinejoin="round"
                                            strokeWidth={2}
                                            d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"
                                          />
                                        </svg>
                                      </span>
                                    </div>
                                  </div>
                                  <div className="tableHeaderBtn">
                                    <button
                                      className="bgBtn"
                                      onClick={handleclickopentestadd}
                                    >
                                      <i className="fas fa-plus me-2"></i>
                                      Add Test
                                    </button>
                                  </div>
                                </div>
                              </div>
                              <div className="pb-0">
                                <div className="table-responsive">
                                  <table className="table">
                                    <thead>
                                      <tr>
                                        <th>Patient </th>
                                        <th>Lab Name</th>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>Doctor Name</th>
                                        <th>Status</th>
                                        <th className="text-center">Action</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      {filteredLabs.length > 0 ? (
                                        filteredLabs.map((item, index) => {
                                          return (
                                            <>
                                              <tr key={index}>
                                                <td>{item.patient_name}</td>
                                                <td>{item.lab_name}</td>
                                                <td>{item.title}</td>
                                                <td>{item.description}</td>
                                                <td>{item.doctor_name}</td>
                                                <td>
                                                  {item.status ||
                                                    item.report_status ||
                                                    "-"}
                                                </td>
                                                <td>
                                                  <div className="d-flex gap-2 justify-content-center">
                                                    <div
                                                      onClick={() =>
                                                        handleLabView(item)
                                                      }
                                                      style={{
                                                        cursor: "pointer",
                                                      }}
                                                      className="avtar avtar-xs btn-link-secondary viewIcon"
                                                    >
                                                      <i className="ti ti-eye f-20" />
                                                      <span>View</span>
                                                    </div>
                                                    <div
                                                      onClick={() =>
                                                        handleLabEdit(item)
                                                      }
                                                      style={{
                                                        cursor: "pointer",
                                                      }}
                                                      className="avtar avtar-xs btn-link-secondary editIcon"
                                                    >
                                                      <i className="ti ti-edit f-20" />
                                                      <span>Edit</span>
                                                    </div>
                                                    <div
                                                      style={{
                                                        cursor: "pointer",
                                                      }}
                                                      className="avtar avtar-xs btn-link-secondary deleteIcon"
                                                      onClick={() =>
                                                        handleLabDelete(item)
                                                      }
                                                    >
                                                      <i className="ti ti-trash f-20" />
                                                      <span>Delete</span>
                                                    </div>
                                                  </div>
                                                </td>
                                              </tr>
                                            </>
                                          );
                                        })
                                      ) : (
                                        <tr>
                                          <td
                                            colSpan="10"
                                            className="text-center"
                                          >
                                            No request found.
                                          </td>
                                        </tr>
                                      )}
                                    </tbody>
                                  </table>
                                </div>
                              </div>
                              {openmodaltest && (
                                <div
                                  className="modal fade show"
                                  style={{
                                    backgroundColor: "rgba(81, 81, 81, 0.5)",
                                    display: "block",
                                  }}
                                >
                                  <div className="modal-dialog modal-lg">
                                    <div className="modal-content">
                                      <div className="modal-header">
                                        <h5 className="modal-title">
                                          Add Test
                                        </h5>
                                      </div>
                                      <div className="modal-body">
                                        <div className="row">
                                          <div className="col-md-6">
                                            <label className="form-label">
                                              Title
                                            </label>
                                            <input
                                              type="text"
                                              name="title"
                                              onChange={handlechange}
                                              placeholder="Title"
                                              className="form-control"
                                            />
                                          </div>
                                          <div className="col-md-6">
                                            <label className="form-label">
                                              Description
                                            </label>
                                            <textarea
                                              type="text"
                                              name="description"
                                              placeholder="Description"
                                              onChange={handlechange}
                                              className="form-control"
                                            />
                                          </div>
                                        </div>
                                        <div className="row">
                                          <div className="col-md-6">
                                            <label className="form-label">
                                              Select Lab
                                            </label>
                                            <select
                                              className="form-select"
                                              name="category"
                                              onChange={handlechange}
                                            >
                                              <option>Select</option>
                                              {data2 &&
                                                data2 &&
                                                data2.map((item, index) => {
                                                  return (
                                                    <>
                                                      <option
                                                        key={index}
                                                        value={item.id}
                                                      >
                                                        {item.lab_name}
                                                      </option>
                                                    </>
                                                  );
                                                })}
                                            </select>
                                          </div>
                                          <div className="col-md-6">
                                            <label className="form-label">
                                              Select Doctor
                                            </label>
                                            <select
                                              name="doctor_id"
                                              onChange={handlechange}
                                              className="form-control"
                                            >
                                              <option>Select</option>
                                              {doctors &&
                                                doctors.length > 0 &&
                                                doctors.map((items, index) => {
                                                  // console.log(items);
                                                  return (
                                                    <option
                                                      key={index}
                                                      value={items.id}
                                                    >
                                                      {items.fullName}
                                                    </option>
                                                  );
                                                })}
                                            </select>
                                          </div>
                                        </div>
                                        <div className="row">
                                          <div className="col-md-12 autoComplete">
                                            <label className="form-label">
                                              Select Services
                                            </label>
                                            <Autocomplete
                                              multiple
                                              id="services-selection"
                                              options={labServices || []}
                                              getOptionLabel={(option) => {
                                                const serviceName =
                                                  option.serviceName ||
                                                  option.service ||
                                                  option.name ||
                                                  "Unknown Service";
                                                const category =
                                                  option.category || "";
                                                const price = option.price
                                                  ? `${option.price} BHD`
                                                  : "";
                                                let label = serviceName;
                                                if (category)
                                                  label += ` (${category})`;
                                                if (price)
                                                  label += ` - ${price}`;
                                                return label;
                                              }}
                                              value={(inpval.serviceIds || [])
                                                .map((id) =>
                                                  labServices.find(
                                                    (service) =>
                                                      service.id === id
                                                  )
                                                )
                                                .filter(Boolean)}
                                              onChange={(e, newValue) => {
                                                const hasSelectAll =
                                                  newValue.some(
                                                    (option) =>
                                                      option &&
                                                      option.isSelectAll
                                                  );
                                                if (hasSelectAll) {
                                                  const isAllSelected =
                                                    inpval.serviceIds &&
                                                    labServices.length > 0 &&
                                                    inpval.serviceIds.length ===
                                                    labServices.length;

                                                  const nextIds = isAllSelected
                                                    ? []
                                                    : labServices.map(
                                                      (service) => service.id
                                                    );
                                                  setInpval((prev) => ({
                                                    ...prev,
                                                    serviceIds: nextIds,
                                                  }));
                                                } else {
                                                  const filtered =
                                                    newValue.filter(
                                                      (option) =>
                                                        !option.isSelectAll
                                                    );
                                                  setInpval((prev) => ({
                                                    ...prev,
                                                    serviceIds: filtered.map(
                                                      (service) => service.id
                                                    ),
                                                  }));
                                                }
                                              }}
                                              renderInput={(params) => (
                                                <TextField
                                                  {...params}
                                                  placeholder="Search services..."
                                                />
                                              )}
                                              filterOptions={(
                                                options,
                                                { inputValue }
                                              ) => {
                                                const searchLower =
                                                  inputValue.toLowerCase();
                                                const filtered = options.filter(
                                                  (option) => {
                                                    const serviceName =
                                                      option.serviceName ||
                                                      option.service ||
                                                      option.name ||
                                                      "";
                                                    const category =
                                                      option.category || "";
                                                    return (
                                                      serviceName
                                                        .toLowerCase()
                                                        .includes(
                                                          searchLower
                                                        ) ||
                                                      category
                                                        .toLowerCase()
                                                        .includes(searchLower)
                                                    );
                                                  }
                                                );
                                                if (!inputValue) {
                                                  return [
                                                    {
                                                      id: "__all__",
                                                      serviceName:
                                                        "Select All Services",
                                                      isSelectAll: true,
                                                    },
                                                    ...filtered,
                                                  ];
                                                }
                                                return filtered;
                                              }}
                                              noOptionsText="No services found"
                                              loadingText="Loading services..."
                                              disabled={
                                                labServices.length === 0 ||
                                                !inpval.category
                                              }
                                              renderOption={(props, option) => {
                                                if (option.isSelectAll) {
                                                  return (
                                                    <li {...props}>
                                                      <strong>
                                                        Select / Deselect All
                                                      </strong>
                                                    </li>
                                                  );
                                                }
                                                const serviceName =
                                                  option.serviceName ||
                                                  option.service ||
                                                  option.name ||
                                                  "Unknown Service";
                                                const category =
                                                  option.category || "";
                                                const price = option.price || 0;
                                                return (
                                                  <li {...props}>
                                                    <div>
                                                      <strong>
                                                        {serviceName}
                                                      </strong>
                                                      {category && (
                                                        <small className="text-muted d-block">
                                                          Category: {category}
                                                        </small>
                                                      )}
                                                      {price > 0 && (
                                                        <small className="text-success d-block">
                                                          Price: {price} BHD
                                                        </small>
                                                      )}
                                                    </div>
                                                  </li>
                                                );
                                              }}
                                              renderTags={(
                                                value,
                                                getTagProps
                                              ) =>
                                                value.map((option, index) => (
                                                  <Chip
                                                    key={option.id}
                                                    label={(() => {
                                                      const serviceName =
                                                        option.serviceName ||
                                                        option.service ||
                                                        option.name ||
                                                        "Unknown Service";
                                                      const category =
                                                        option.category || "";
                                                      const price = option.price
                                                        ? `${option.price} BHD`
                                                        : "";
                                                      let label = serviceName;
                                                      if (category)
                                                        label += ` (${category})`;
                                                      if (price)
                                                        label += ` - ${price}`;
                                                      return label;
                                                    })()}
                                                    {...getTagProps({ index })}
                                                    color="primary"
                                                    variant="outlined"
                                                  />
                                                ))
                                              }
                                            />
                                          </div>
                                        </div>
                                        <div className="row">
                                          <div className="col-md-12">
                                            <label className="form-label">
                                              Attachment
                                            </label>
                                            <input
                                              type="file"
                                              name="file"
                                              onChange={handlechange}
                                              className="form-control"
                                              accept="image/*,application/pdf,.doc,.docx"
                                            />
                                            {inpval.file && (
                                              <small className="text-muted">
                                                Selected file:{" "}
                                                {inpval.file.name}
                                              </small>
                                            )}
                                          </div>
                                        </div>
                                      </div>
                                      <div className="modal-footer justify-content-end">
                                        <button
                                          type="button"
                                          className="cancelText"
                                          onClick={closeModaladdtest}
                                        >
                                          Cancel
                                        </button>
                                        <button
                                          type="button"
                                          className="bgBtn"
                                          onClick={handletest}
                                        >
                                          Add test
                                        </button>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              )}
                            </div>
                          </div>
                        </div>
                        <div className="mb-3 cardBorder my-4">
                          <div className="tableHeader d-flex justify-content-between align-items-center">
                            <div className="d-flex align-items-center gap-3">
                              <h5 className="mb-0">Services</h5>
                              <div
                                className="tableSearch"
                                style={{ position: "relative", width: "250px" }}
                              >
                                <input
                                  type="text"
                                  placeholder="Search services..."
                                  className="form-control"
                                  value={serviceTableSearchTerm}
                                  onChange={(e) =>
                                    setServiceTableSearchTerm(e.target.value)
                                  }
                                  style={{ paddingLeft: "35px" }}
                                />
                                <span className="searchIcon">
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="18"
                                    height="18"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="gray"
                                    style={{
                                      position: "absolute",
                                      top: "50%",
                                      left: "10px",
                                      transform: "translateY(-50%)",
                                      pointerEvents: "none",
                                    }}
                                  >
                                    <path
                                      strokeLinecap="round"
                                      strokeLinejoin="round"
                                      strokeWidth={2}
                                      d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"
                                    />
                                  </svg>
                                </span>
                              </div>
                            </div>
                            {hasActiveInsuranceCard && (
                              <span className="badge bg-success ms-2"></span>
                            )}
                            <div className="d-flex gap-2">
                              <button
                                className="borderBtn"
                                onClick={handlePrintClick}
                                disabled={safeServices.length === 0}
                                title={
                                  safeServices.length === 0
                                    ? "No services to print"
                                    : "Print selected services"
                                }
                              >
                                <i className="ti ti-printer me-1"></i>
                                Print
                              </button>
                              <button
                                className="borderBtn"
                                onClick={handleAddService}
                              >
                                Add Services
                              </button>
                            </div>
                          </div>
                          <div className="card-body">
                            <div className="table-responsive">
                              <table className="table">
                                <thead>
                                  <tr>
                                    <th>Sn</th>
                                    <th>Date-Time</th>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Notes</th>
                                    <th>
                                      {hasActiveInsuranceCard ? "Cost" : "Cost"}
                                    </th>
                                    <th>VAT</th>
                                    <th>Discount</th>
                                    <th>Net Amt.</th>
                                    <th>Status</th>
                                    <th className="text-center">Actions</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  {paginatedServices.map((service, index) => {
                                    const serial =
                                      (currentServicePage - 1) *
                                      servicesPerPage +
                                      index +
                                      1;
                                    const serviceData = availableServices.find(
                                      (s) =>
                                        s.id ===
                                        (service.serviceId ??
                                          service.service_id)
                                    );
                                    const vatDisplay = serviceData
                                      ? serviceData.vatEnabled
                                        ? `${serviceData.vatValue}%`
                                        : "0%"
                                      : service.vat_value
                                        ? `${service.vat_value}%`
                                        : "0%";
                                    return (
                                      <tr key={index}>
                                        <td>{serial}</td>
                                        <td>
                                          {(() => {
                                            const ts =
                                              service.createdAt ||
                                              service.created_at ||
                                              service.dateTime ||
                                              service.datetime;
                                            const d = ts ? new Date(ts) : null;
                                            return d && !isNaN(d.getTime())
                                              ? d.toLocaleDateString("en-US", {
                                                month: "2-digit",
                                                day: "2-digit",
                                                year: "numeric",
                                              }) +
                                              " " +
                                              d.toLocaleTimeString(
                                                "en-US",
                                                {
                                                  hour: "numeric",
                                                  minute: "2-digit",
                                                  second: "2-digit",
                                                  hour12: true,
                                                }
                                              )
                                              : "-";
                                          })()}
                                        </td>
                                        <td>
                                          {serviceData?.code ||
                                            service.serviceCode ||
                                            "-"}
                                        </td>
                                        <td>
                                          {serviceData?.serviceName ||
                                            service.serviceName ||
                                            "-"}
                                        </td>
                                        <td
                                          style={{
                                            maxWidth: "250px",
                                            whiteSpace: "normal",
                                            wordWrap: "break-word",
                                          }}
                                        >
                                          {serviceData?.description ||
                                            service.description ||
                                            "-"}
                                        </td>
                                        <td
                                          style={{
                                            maxWidth: "250px",
                                            whiteSpace: "normal",
                                            wordWrap: "break-word",
                                          }}
                                          title={service.extra_notes || "-"}
                                        >
                                          {service.extra_notes || "-"}
                                        </td>
                                        <td>
                                          {hasActiveInsuranceCard
                                            ? serviceData?.insurancePrice ??
                                            serviceData?.insurance_price ??
                                            service.insurancePrice ??
                                            service.insurance_price ??
                                            0
                                            : serviceData?.standardCost ||
                                            service.standardCost ||
                                            0}{" "}
                                          BHD
                                        </td>
                                        <td>{vatDisplay}</td>
                                        <td>
                                          {(service.discount_value ??
                                            service.discount_value ??
                                            0) > 0 ? (
                                            <>
                                              {(
                                                service.discountType ||
                                                service.discount_type ||
                                                ""
                                              )
                                                .toString()
                                                .toLowerCase() === "percentage"
                                                ? `${service.discountValue ??
                                                service.discount_value
                                                }%`
                                                : `-${service.discountValue ??
                                                service.discount_value
                                                } BHD`}
                                            </>
                                          ) : (
                                            "-"
                                          )}
                                        </td>
                                        <td>
                                          {service.netAmount ??
                                            service.net_amount}{" "}
                                          BHD
                                        </td>
                                        <td>
                                          <select
                                            className="form-select form-select-sm border-primary shadow-sm px-1 py-0"
                                            style={{
                                              minWidth: 90,
                                              fontWeight: 500,
                                              fontSize: "0.85em",
                                              height: "1.8em",
                                              backgroundColor: "#f8f9fa",
                                            }}
                                            value={service.status || "Plan"}
                                            title="Change status"
                                            disabled={
                                              (service.status || "")
                                                .toString()
                                                .toLowerCase() === "complete" ||
                                              (service.status || "")
                                                .toString()
                                                .toLowerCase() === "completed"
                                            }
                                            onChange={async (e) => {
                                              const current = (
                                                service.status || ""
                                              )
                                                .toString()
                                                .toLowerCase();
                                              if (
                                                current === "complete" ||
                                                current === "completed"
                                              )
                                                return;
                                              const newStatus = e.target.value;
                                              await handleServiceStatusChange(
                                                service.id,
                                                newStatus
                                              );
                                            }}
                                          >
                                            <option value="Plan">Plan</option>
                                            <option value="Complete">
                                              Completed
                                            </option>
                                          </select>
                                        </td>
                                        <td className="text-center">
                                          <div
                                            onClick={() =>
                                              handleEditService(service)
                                            }
                                            style={{ cursor: "pointer" }}
                                            className="avtar avtar-xs btn-link-secondary editIcon"
                                          >
                                            <i className="ti ti-edit f-20" />
                                            <span>Edit</span>
                                          </div>
                                        </td>
                                      </tr>
                                    );
                                  })}
                                  {paginatedServices.length === 0 && (
                                    <tr>
                                      <td colSpan="10" className="text-center">
                                        No services added yet
                                      </td>
                                    </tr>
                                  )}
                                </tbody>
                              </table>
                            </div>
                            {totalServicePages > 1 && (
                              <nav className="tablepagination d-flex justify-content-end mt-3 mb-2">
                                <ul className="pagination mb-0">
                                  <li
                                    className={`page-item ${currentServicePage === 1 ? "disabled" : ""
                                      }`}
                                  >
                                    <button
                                      className="page-link"
                                      onClick={() =>
                                        currentServicePage > 1 &&
                                        setCurrentServicePage(
                                          currentServicePage - 1
                                        )
                                      }
                                    >
                                      &laquo;
                                    </button>
                                  </li>
                                  <li className="pageNmbr">{`${currentServicePage} of ${totalServicePages}`}</li>
                                  <li
                                    className={`page-item ${currentServicePage === totalServicePages
                                      ? "disabled"
                                      : ""
                                      }`}
                                  >
                                    <button
                                      className="page-link"
                                      onClick={() =>
                                        currentServicePage <
                                        totalServicePages &&
                                        setCurrentServicePage(
                                          currentServicePage + 1
                                        )
                                      }
                                    >
                                      &raquo;
                                    </button>
                                  </li>
                                </ul>
                              </nav>
                            )}
                            {serviceModalOpen && (
                              <div
                                className="modal fade show"
                                style={{ display: "block" }}
                                tabIndex="-1"
                              >
                                <div className="modal-dialog modal-lg">
                                  <div className="modal-content">
                                    <div className="modal-header">
                                      <h5 className="modal-title">
                                        {selectedService
                                          ? "Edit Service"
                                          : "Add Service"}
                                      </h5>
                                    </div>
                                    <form onSubmit={handleServiceSubmit}>
                                      <div className="modal-body">
                                        {!serviceFormData.serviceId && (
                                          <div>
                                          </div>
                                        )}
                                        <div className="row">
                                          <div
                                            className="col-md-12 position-relative"
                                            ref={serviceDropdownRef}
                                          >
                                            <label className="form-label">
                                              Search & Select Service{" "}
                                              <span className="text-danger">
                                                *
                                              </span>
                                            </label>
                                            <input
                                              type="text"
                                              className={`form-control ${!serviceFormData.serviceId
                                                ? "border-warning"
                                                : ""
                                                }`}
                                              placeholder="Type to search by name or code..."
                                              value={searchServiceQuery}
                                              onChange={(e) => {
                                                setSearchServiceQuery(
                                                  e.target.value
                                                );
                                                setShowServiceSuggestions(true);
                                              }}
                                              onFocus={() =>
                                                setShowServiceSuggestions(true)
                                              }
                                              required
                                            />
                                            {!serviceFormData.serviceId && (
                                              <div className="form-text text-warning">
                                                <i className="ti ti-alert-circle me-1"></i>
                                                Please select a service from the
                                                dropdown list
                                              </div>
                                            )}
                                            {showServiceSuggestions && (
                                              <div
                                                className="list-group shadow"
                                                style={{
                                                  maxHeight: 240,
                                                  overflowY: "auto",
                                                  position: "absolute",
                                                  width: "100%",
                                                  zIndex: 1051,
                                                }}
                                              >
                                                {filteredServices.length ===
                                                  0 && (
                                                    <div></div>
                                                  )}
                                                {filteredServices.map(
                                                  (service) => (
                                                    <button
                                                      key={service.id}
                                                      type="button"
                                                      className={`list-group-item list-group-item-action ${service.id ===
                                                        serviceFormData.serviceId
                                                        ? "active"
                                                        : ""
                                                        }`}
                                                      onClick={() => {
                                                        const baseCost =
                                                          hasActiveInsuranceCard
                                                            ? service.insurancePrice ??
                                                            service.insurance_price ??
                                                            service.standardCost
                                                            : service.standardCost;
                                                        setServiceFormData({
                                                          ...serviceFormData,
                                                          serviceId: service.id,
                                                          customCost:
                                                            baseCost || "",
                                                        });
                                                        setSearchServiceQuery(
                                                          `${service.code} - ${service.serviceName}`
                                                        );
                                                        setShowServiceSuggestions(
                                                          false
                                                        );
                                                      }}
                                                    >
                                                      {service.code} -{" "}
                                                      {service.serviceName} (
                                                      {hasActiveInsuranceCard
                                                        ? `${service.insurancePrice ??
                                                        service.insurance_price ??
                                                        service.standardCost
                                                        } BHD`
                                                        : `${service.standardCost} BHD`}
                                                      )
                                                    </button>
                                                  )
                                                )}
                                              </div>
                                            )}
                                          </div>
                                          {(() => {
                                            const s = availableServices.find(
                                              (x) =>
                                                x.id ===
                                                serviceFormData.serviceId
                                            );
                                            return (
                                              <>
                                                <div className="col-md-6">
                                                  <label className="form-label">
                                                    Code
                                                  </label>
                                                  <input
                                                    className="form-control"
                                                    value={s?.code || ""}
                                                    readOnly
                                                  />
                                                </div>
                                                <div className="col-md-6">
                                                  <label className="form-label">
                                                    Name
                                                  </label>
                                                  <input
                                                    className="form-control"
                                                    value={s?.serviceName || ""}
                                                    readOnly
                                                  />
                                                </div>
                                                <div className="col-md-6">
                                                  <label className="form-label">
                                                    {hasActiveInsuranceCard
                                                      ? "Insurance Cost"
                                                      : "Standard Cost"}{" "}
                                                    (Editable)
                                                  </label>
                                                  <input
                                                    type="number"
                                                    className="form-control"
                                                    value={
                                                      serviceFormData.customCost
                                                    }
                                                    onChange={(e) =>
                                                      setServiceFormData({
                                                        ...serviceFormData,
                                                        customCost:
                                                          e.target.value,
                                                      })
                                                    }
                                                    step="0.01"
                                                    min="0"
                                                    placeholder={(() => {
                                                      const defaultCost =
                                                        hasActiveInsuranceCard
                                                          ? s?.insurancePrice ??
                                                          s?.insurance_price ??
                                                          s?.standardCost
                                                          : s?.standardCost;
                                                      return defaultCost || "";
                                                    })()}
                                                  />
                                                </div>
                                                <div className="col-md-6">
                                                  <label className="form-label">
                                                    VAT
                                                  </label>
                                                  <input
                                                    className="form-control"
                                                    value={
                                                      s
                                                        ? s.vatEnabled
                                                          ? `${s.vatValue}%`
                                                          : "0%"
                                                        : ""
                                                    }
                                                    readOnly
                                                  />
                                                </div>
                                                <div className="col-md-12">
                                                  <label className="form-label">
                                                    Description
                                                  </label>
                                                  <textarea
                                                    className="form-control"
                                                    rows="2"
                                                    value={s?.description || ""}
                                                    readOnly
                                                  />
                                                </div>
                                              </>
                                            );
                                          })()}
                                          <div className="col-md-12 ">
                                            <label className="form-label">
                                              Extra Notes
                                            </label>
                                            <textarea
                                              className="form-control"
                                              rows="3"
                                              value={serviceFormData.extraNotes}
                                              onChange={(e) =>
                                                setServiceFormData({
                                                  ...serviceFormData,
                                                  extraNotes: e.target.value,
                                                })
                                              }
                                            ></textarea>
                                          </div>
                                          <div className="col-md-6 ">
                                            <label className="form-label">
                                              Discount Type
                                            </label>
                                            <select
                                              className="form-select"
                                              value={
                                                serviceFormData.discountType
                                              }
                                              onChange={(e) =>
                                                setServiceFormData({
                                                  ...serviceFormData,
                                                  discountType: e.target.value,
                                                })
                                              }
                                            >
                                              <option value="Amount">
                                                By Amount BHD
                                              </option>
                                              <option value="Percentage">
                                                By Percentage (%)
                                              </option>
                                            </select>
                                          </div>
                                          <div className="col-md-6">
                                            <label className="form-label">
                                              Discount Value
                                            </label>
                                            <input
                                              type="number"
                                              className="form-control"
                                              value={
                                                serviceFormData.discountValue
                                              }
                                              onChange={(e) =>
                                                setServiceFormData({
                                                  ...serviceFormData,
                                                  discountValue:
                                                    parseFloat(
                                                      e.target.value
                                                    ) || 0,
                                                })
                                              }
                                              min="0"
                                              step="0.01"
                                            />
                                          </div>
                                        </div>
                                      </div>
                                      <div className="modal-footer">
                                        <button
                                          type="button"
                                          className="cancelText"
                                          onClick={() =>
                                            setServiceModalOpen(false)
                                          }
                                        >
                                          Cancel
                                        </button>
                                        <button
                                          type="submit"
                                          className={`${!serviceFormData.serviceId
                                            ? "disableBtn"
                                            : "bgBtn"
                                            }`}
                                          disabled={!serviceFormData.serviceId}
                                          title={
                                            !serviceFormData.serviceId
                                              ? "Please select a service first"
                                              : ""
                                          }
                                        >
                                          {selectedService ? "Update" : "Add"}{" "}
                                          Service
                                        </button>
                                      </div>
                                    </form>
                                  </div>
                                </div>
                              </div>
                            )}
                          </div>
                        </div>
                        {printModalOpen && (
                          <div
                            className="modal fade show"
                            style={{ display: "block" }}
                            tabIndex="-1"
                          >
                            <div className="modal-dialog modal-lg">
                              <div className="modal-content">
                                <div className="modal-header">
                                  <h5 className="modal-title">
                                    Select Services to Print
                                  </h5>
                                </div>
                                <div className="modal-body billingModal">
                                  <div className="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                      <h6>
                                        Choose services you want on the printout
                                      </h6>
                                    </div>
                                    <button
                                      type="button"
                                      className="borderBtn"
                                      onClick={handleSelectAllServices}
                                    >
                                      Select / Deselect All
                                    </button>
                                  </div>
                                  <div className="list-group">
                                    {safeServices.length === 0 && (
                                      <div className="list-group-item text-muted">
                                        No services available
                                      </div>
                                    )}
                                    {safeServices.map((service) => (
                                      <label
                                        key={service.id}
                                        className="list-group-item d-flex align-items-center"
                                        style={{ cursor: "pointer" }}
                                      >
                                        <input
                                          type="checkbox"
                                          className="form-check-input me-2"
                                          checked={selectedPrintIds.includes(
                                            service.id
                                          )}
                                          onChange={() =>
                                            handleServiceSelection(service.id)
                                          }
                                        />
                                        <div className="flex-grow-1">
                                          <div>
                                            <strong>
                                              {service.serviceName ||
                                                service.service_name ||
                                                service.name ||
                                                "Service"}
                                            </strong>{" "}
                                            <span className="text-muted">
                                              {service.serviceCode ||
                                                service.service_code ||
                                                service.code
                                                ? `(${service.serviceCode ||
                                                service.service_code ||
                                                service.code
                                                })`
                                                : ""}
                                            </span>
                                          </div>
                                          <div className="small text-muted">
                                            Net:{" "}
                                            {service.netAmount ??
                                              service.net_amount ??
                                              0}{" "}
                                            BHD
                                          </div>
                                        </div>
                                      </label>
                                    ))}
                                  </div>
                                </div>
                                <div className="modal-footer">
                                  <button
                                    type="button"
                                    className="cancelText"
                                    onClick={() => {
                                      setPrintModalOpen(false);
                                      setIsSelectingForPrint(false);
                                    }}
                                  >
                                    Cancel
                                  </button>
                                  <button
                                    type="button"
                                    className="bgBtn"
                                    onClick={handlePrintSelected}
                                    disabled={selectedPrintIds.length === 0}
                                  >
                                    Print Selected
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        )}
                        {printModalOpen && (
                          <div className="modal-backdrop fade show"></div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                className="tab-pane fade"
                id="forms"
                role="tabpanel"
                aria-labelledby="forms-tab"
              >
                <div className="col-12">
                  <PatientForms patientId={location?.state?.patientid?.id} />
                </div>
              </div>
              <div
                className="tab-pane fade"
                id="service"
                role="tabpanel"
                aria-labelledby="service-tab"
              >
                <div className="col-12">
                  <PatientServices
                    patientId={location?.state?.patientid?.id}
                    doctorId={
                      JSON.parse(localStorage.getItem("userMedical"))?.id
                    }
                    insurance={0}
                    vat={0}
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {showEditLabModal && (
        <div
          className="modal fade show"
          style={{
            backgroundColor: "rgba(0,0,0,0.5)",
            display: "block",
          }}
        >
          <div className="modal-dialog modal-lg">
            <div className="modal-content">
              <div className="modal-header">
                <h5 className="modal-title">Edit Lab Request</h5>
              </div>
              <form onSubmit={handleEditLabSubmit}>
                <div className="modal-body">
                  <div className="row">
                    <div className="col-lg-6">
                      <label className="form-label">Lab</label>
                      <select
                        className="form-select"
                        name="lab_id"
                        value={editLabData.lab_id}
                        onChange={handleEditLabChange}
                        required
                      >
                        <option value="">Select Lab</option>
                        {labs.map((lab) => (
                          <option key={lab.id} value={lab.id}>
                            {lab.lab_name}
                          </option>
                        ))}
                      </select>
                    </div>
                    <div className="col-lg-6">
                      <label className="form-label">Title</label>
                      <input
                        type="text"
                        className="form-control"
                        name="title"
                        value={editLabData.title}
                        onChange={handleEditLabChange}
                        placeholder="title"
                        required
                      />
                    </div>
                  </div>
                  <div>
                    <label className="form-label">Description</label>
                    <textarea
                      className="form-control"
                      name="description"
                      value={editLabData.description}
                      onChange={handleEditLabChange}
                      required
                    />
                  </div>
                  <div className="mt-3">
                    <label className="form-label">Lab Services</label>
                    <Autocomplete
                      multiple
                      id="edit-lab-services"
                      options={labServices || []}
                      getOptionLabel={(option) => {
                        const serviceName =
                          option.serviceName ||
                          option.service ||
                          option.service_name ||
                          option.name ||
                          "Unknown Service";
                        const category = option.category || "";
                        const price = option.price ? `${option.price} BHD` : "";
                        let label = serviceName;
                        if (category) label += ` (${category})`;
                        if (price) label += ` - ${price}`;
                        return label;
                      }}
                      value={(editLabData.serviceIds || [])
                        .map((id) =>
                          labServices.find((service) => service.id === id)
                        )
                        .filter(Boolean)}
                      onChange={handleEditLabServicesChange}
                      disabled={!editLabData.lab_id || labServices.length === 0}
                      renderInput={(params) => (
                        <TextField
                          {...params}
                          placeholder={
                            editLabData.lab_id
                              ? "Search and select services..."
                              : "Please select a lab first"
                          }
                        />
                      )}
                      renderTags={(value, getTagProps) =>
                        value.map((option, index) => {
                          const serviceName =
                            option.serviceName ||
                            option.service ||
                            option.service_name ||
                            option.name ||
                            "Unknown Service";
                          const category = option.category || "";
                          const price = option.price
                            ? `${option.price} BHD`
                            : "";
                          let label = serviceName;
                          if (category) label += ` (${category})`;
                          if (price) label += ` - ${price}`;
                          return (
                            <Chip
                              key={option.id}
                              label={label}
                              {...getTagProps({ index })}
                              color="primary"
                              variant="outlined"
                            />
                          );
                        })
                      }
                      filterOptions={(options, { inputValue }) => {
                        const searchLower = inputValue.toLowerCase();
                        const filtered = options.filter((option) => {
                          const serviceName =
                            option.serviceName ||
                            option.service ||
                            option.service_name ||
                            option.name ||
                            "";
                          const category = option.category || "";
                          return (
                            serviceName.toLowerCase().includes(searchLower) ||
                            category.toLowerCase().includes(searchLower)
                          );
                        });
                        if (!inputValue) {
                          return [
                            {
                              id: "__all__",
                              serviceName: "Select All Services",
                              isSelectAll: true,
                            },
                            ...filtered,
                          ];
                        }
                        return filtered;
                      }}
                      renderOption={(props, option) => {
                        if (option.isSelectAll) {
                          return (
                            <li {...props}>
                              <strong>Select / Deselect All</strong>
                            </li>
                          );
                        }
                        const serviceName =
                          option.serviceName ||
                          option.service ||
                          option.service_name ||
                          option.name ||
                          "Unknown Service";
                        const category = option.category || "";
                        const price = option.price || 0;
                        return (
                          <li {...props}>
                            <div>
                              <strong>{serviceName}</strong>
                              {category && (
                                <small className="text-muted d-block">
                                  Category: {category}
                                </small>
                              )}
                              {price > 0 && (
                                <small className="text-success d-block">
                                  Price: {price} BHD
                                </small>
                              )}
                            </div>
                          </li>
                        );
                      }}
                    />
                  </div>
                  <div>
                    <label className="form-label">
                      Attachments ({editLabAttachments.length})
                    </label>
                    {editLabAttachments.length > 0 && (
                      <div className="table-responsive mb-3">
                        <table className="table table-sm table-bordered">
                          <thead>
                            <tr>
                              <th>Name</th>
                              <th>File</th>
                              <th>Status</th>
                              <th>Uploaded At</th>
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            {editLabAttachments.map((attachment) => (
                              <tr key={attachment.attachment_id}>
                                <td>{attachment.attachment_name}</td>
                                <td>
                                  {attachment.filename ? (
                                    <a
                                      href={`${baseurImage}${attachment.filename}`}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      className="btn btn-sm btn-outline-primary"
                                    >
                                      View File
                                    </a>
                                  ) : (
                                    "No file"
                                  )}
                                </td>
                                <td>{attachment.report_status}</td>
                                <td>
                                  {new Date(
                                    attachment?.uploaded_at
                                  ).toLocaleDateString()}
                                </td>
                                <td>
                                  <button
                                    type="button"
                                    onClick={() =>
                                      handleDeleteLabAttachment(
                                        attachment.attachment_id
                                      )
                                    }
                                  >
                                    <i className="ti ti-trash f-20"></i>
                                  </button>
                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}
                    <div className="row">
                      <div className="col-md-4">
                        <label className="form-label">Add New Attachment</label>
                        <input
                          type="file"
                          name="newAttachment"
                          onChange={handleEditLabFileChange}
                          className="form-control"
                          accept="image/*,application/pdf,.doc,.docx"
                        />
                      </div>
                      <div className="col-md-4">
                        <label className="form-label">Attachment Name</label>
                        <input
                          type="text"
                          name="attachmentName"
                          value={editLabData.attachmentName || ""}
                          onChange={handleEditLabChange}
                          className="form-control"
                          placeholder="Enter attachment name"
                        />
                      </div>
                      <div className="col-md-4">
                        <label className="form-label">Status</label>
                        <select
                          name="attachmentStatus"
                          value={editLabData.attachmentStatus || ""}
                          onChange={handleEditLabChange}
                          className="form-select"
                        >
                          <option value="">Select Status</option>
                          <option value="Positive">Positive</option>
                          <option value="Negative">Negative</option>
                        </select>
                      </div>
                    </div>
                    <div className="mt-2">
                      <button
                        type="button"
                        className="btn btn-sm btn-outline-primary"
                        onClick={handleAddLabAttachment}
                        disabled={
                          !editLabData.newAttachment ||
                          !editLabData.attachmentName ||
                          !editLabData.attachmentStatus
                        }
                      >
                        Add Attachment
                      </button>
                    </div>
                  </div>
                </div>
                <div className=" modal-footer d-flex justify-content-end">
                  <button
                    type="button "
                    className="cancelText"
                    onClick={() => setShowEditLabModal(false)}
                  >
                    Cancel
                  </button>
                  <button type="submit" className="bgBtn">
                    Save
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      )}
      <ToastContainer />
    </div>
  );
}
